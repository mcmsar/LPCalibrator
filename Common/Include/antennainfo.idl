cpp_quote("#ifndef INC_ANTENNAINFO")
cpp_quote("#define INC_ANTENNAINFO")

cpp_quote(" ")
cpp_quote("#define EMS_ANTENNAINFO_MAX_SATELLITES (128)")
cpp_quote(" ")

#define EMS_ANTENNAINFO_MAX_SATELLITES (128)

import "unknwn.idl";
import "emstypex.idl";
import "sigdata.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(874061ED-7716-443a-9628-8686F9FF3822),
	helpstring("IEMSANTENNAINFOData Interface"),
	pointer_default(unique)
]

interface IEMSANTENNAINFOData
{
typedef enum _tagEMSANTENNATYPECODE
{
// 
// 	Attributes
//
		EMSAntennaTrackingType	= 0x0800,
		EMSAntennaNativeType		= 0x0400,
		EMSAntennaForeignType	= 0x0200,

		EMSAntennaGeoType			= 0x0080,
		EMSAntennaLeoType			= 0x0040,
		EMSAntennaMeoType			= 0x0020,
		EMSAntennaDBFType			= 0x0010,
// 
// 	Specific products
//
		EMSAntennaGeoLut600	= EMSAntennaGeoType + EMSAntennaNativeType,
		EMSAntennaLeoLut600	= EMSAntennaLeoType + EMSAntennaTrackingType + EMSAntennaNativeType,

//	Unknown
		EMSAntennaTypeUnknown 		= 0x0000
}	EMSANTENNATYPECODE;

#pragma pack(1)

	typedef struct _tagEMSANTENNAINFO
	{
		ULONG ulLutID;
		ULONG ulAntennaID;
		EMSANTENNATYPECODE type;
		double dAzMin;
		double dAzMax;
		double dElMin;
		double dElMax;
		ULONG ulSatCount;
		ULONG ulSatellites[ EMS_ANTENNAINFO_MAX_SATELLITES ];
	} EMSANTENNAINFO, *LPEMSANTENNAINFO;

#pragma pack()
};

cpp_quote("#endif // INC_ANTENNAINFO")
