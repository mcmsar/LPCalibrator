[
	object, 
	uuid(2030FA6F-8600-4534-8A29-B07AD50C34EC),
	helpstring("IEMSAudioGtwy Interface"),
	pointer_default(unique)
]
interface IEMSAudioGtwy : IUnknown
{
	// --- real time audio requests ---
	HRESULT AudioConnect( [in] const unsigned long culLutID,
						  [in] EMSGATEWAYTOKEN* psecToken,
						  [in,out] unsigned long* ulSession );

	HRESULT AudioGetData( [in] unsigned long ulDestID,
					 [in] const unsigned long ulSession,
					 [in] EMSGATEWAYTOKEN* psecToken,
					 [in,out,size_is(*pLen)] unsigned char* pData,
					 [in,out] unsigned int* pLen );

	HRESULT AudioSetParameters( [in] unsigned long ulDestID,
	                       [in] const unsigned long ulSession,
						   [in] EMSGATEWAYTOKEN* psecToken,
						   [in] const float fCenterFreq, 
						   [in] const float fBandwidth);

	HRESULT AudioDisconnect( [in] unsigned long ulDestID,
	                    [in] const unsigned long culSession,
						[in] EMSGATEWAYTOKEN* psecToken );

	// --- free requests - based on audio frequency / time parameters ---

	HRESULT AudioMakeFreeRequest( [in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] EMSAUDIOREQUEST audreq,
	                    [in,out] unsigned long* pulSessionID );

	HRESULT AudioGetFreeRequestData( [in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] unsigned long ulSessionID,
						[in,out] EMSAUDIODATARECORD_RIFF* audrec );

	HRESULT AudioCancelFreeRequest( [in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] unsigned long ulSessionID);

};


