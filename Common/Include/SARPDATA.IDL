cpp_quote("#ifndef INC_SARPDATA")
cpp_quote("#define INC_SARPDATA")

import "unknwn.idl";
import "emstypex.idl";
import "sigdata.idl";

#define EMSSARPMSGLENGTH ( 24 )
#define EMSSARPBEACONMSGLENGTH ( 18 )

cpp_quote("#define EMSSARPMSGLENGTH ( 24 )")
cpp_quote("#define EMSSARPBEACONMSGLENGTH ( 18 )")
cpp_quote("")
cpp_quote("// definitions for ( wStatus )")
cpp_quote("#define EMSSARPFLAG_PSEUDOMSG	( 0x0001 )")
cpp_quote("#define EMSSARPFLAG_DRU0			( 0x0002 )")
cpp_quote("#define EMSSARPFLAG_DRU1			( 0x0004 )")
cpp_quote("#define EMSSARPFLAG_DRU2			( 0x0008 )")
cpp_quote("#define EMSSARPFLAG_DRU3			( 0x0010 )")
cpp_quote("#define EMSSARPFLAG_LONGMSG		( 0x0020 )	// set if long msg format")
cpp_quote("#define EMSSARPFLAG_ROLLOVER		( 0x0040 )")
cpp_quote("#define EMSSARPFLAG_REALDUMP		( 0x0080 )        // realtime data or dump data")
cpp_quote("#define EMSSARPFLAG_FREQPARITY	( 0x0100 )	// set if error")
cpp_quote("#define EMSSARPFLAG_TIMEPARITY	( 0x0200 )	// set if error")
cpp_quote("#define EMSSARPFLAG_NEWDAYSTART	( 0x0400 )	// start of a new day (cospas only) ")
cpp_quote("#define EMS_FLAG_INVERTED_FRAMESYNC	( 0x0800 )	// inverted framesync")
cpp_quote("")
cpp_quote("#define EMS_FLAG_TIME_VALID		( 0x1000 ) " )
cpp_quote("#define EMS_FLAG_TEST_MSG		( 0x2000 )	")
cpp_quote("#define EMS_FLAG_HISTORICAL_MSG	( 0x4000 )	")
cpp_quote("#define EMS_FLAG_PROCESSED_MSG	( 0x8000 )	")

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(E3681A63-EAB0-11d5-8D22-009027912866),
	helpstring("IEMSSARPdata"),
	pointer_default(unique)
]


interface IEMSSARPdata
{
#pragma pack(1)

typedef enum _tagEMSSARPDATATYPE
{
   EMSSARPTYPE_COSPAS         = 0x8000,
   EMSSARPTYPE_SARSAT         = 0x4000,
   EMSSARPTYPE_HOUSEKEEPING   = 0x2000,

   EMSSARPTYPE_SARP0          = 0x0000,
   EMSSARPTYPE_SARP1          = 0x0001,
   EMSSARPTYPE_SARP2          = 0x0002,
   EMSSARPTYPE_SARP3          = 0x0003,

   EMSSARPTYPE_SARSATSARP0    = EMSSARPTYPE_SARSAT + EMSSARPTYPE_SARP0,
   EMSSARPTYPE_SARSATSARP1    = EMSSARPTYPE_SARSAT + EMSSARPTYPE_SARP1,
   EMSSARPTYPE_SARSATSARP2    = EMSSARPTYPE_SARSAT + EMSSARPTYPE_SARP2,
   EMSSARPTYPE_SARSATSARP3    = EMSSARPTYPE_SARSAT + EMSSARPTYPE_SARP3,
   EMSSARPTYPE_SARSATSARP3HK  = EMSSARPTYPE_SARSAT + EMSSARPTYPE_SARP3 + EMSSARPTYPE_HOUSEKEEPING,

   EMSSARPTYPE_COSPASSARP0    = EMSSARPTYPE_COSPAS + EMSSARPTYPE_SARP0,
   EMSSARPTYPE_COSPASSARP1    = EMSSARPTYPE_COSPAS + EMSSARPTYPE_SARP1,
   EMSSARPTYPE_COSPASSARP2    = EMSSARPTYPE_COSPAS + EMSSARPTYPE_SARP2
} EMSSARPDATATYPE;

cpp_quote("#define EMSSARPTYPE_SARPNUMBERMASK    0x000F  // reserve 4 LSBs for sarp type (ie. sarp-0, sarp-1, etc...)")
cpp_quote("#define SARPTYPE( val )        ( val & EMSSARPTYPE_SARPNUMBERMASK )")
cpp_quote("#define ISHKSARPMSG( val )     ((val & EMSSARPTYPE_HOUSEKEEPING) != 0 )")
cpp_quote("#define ISCOSPASSARPMSG( val ) ((val & EMSSARPTYPE_COSPAS) != 0 )")
cpp_quote("#define ISSARSATSARPMSG( val ) ((val & EMSSARPTYPE_SARSAT) != 0 )")


typedef struct _tagEMSSARPDATA
{
	EMSSIGDATAIDTYPE	hdr;					// time, ulSatID, ulLutID, wType
	ULONG			ulPassID;					// Pass ID
	INT64			i64BeaconID;				// Beacon ID
	EMSTIME		timeMsg;						// encoded msg time
	INT64			i64TimeOffset;				// nanosecond time correction 
	WORD			wStatus;						// Status : ( DRU, Format Flag, Rollover, Freq Parity, 
													// time parity
													// ( DRU = data reduction unit )
	double 		dFrequency;					// Frequency in Hz
	float			fFreqOffset;				// Frequency offset in Hz (satellite/ground station dependency)
	float			fAvgPower;					// Average Bit Power
	float			fCarrierPower;				// dBm
	WORD			wBitErrorFrameSync;     // Number of bit errors in Frame sync
	WORD			wBitErrorField1;        // Number of bit errors in first protected field
	WORD			wBitErrorField2;        // Number of bit errors in second protected field
	float			fBitRate;					// Bit rate of the 2.4 KB data stream 
													// ( expected value should be 2400 )
	BYTE			cMsg[EMSSARPMSGLENGTH];	// transmitted 406 single burst detection
	BYTE			cBeaconMsg[EMSSARPBEACONMSGLENGTH];	
} EMSSARPDATA, *LPEMSSARPDATA;

#pragma pack()
}

cpp_quote("#endif // INC_SARPDATA")









