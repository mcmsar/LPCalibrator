#define MAX_LONG_COUNTRY_NAME_LEN	10
#define MAX_SHORT_COUNTRY_NAME_LEN	3
typedef struct _tagEMSCOUNTRYCODEINFO
{
	wchar_t		wszLongName[MAX_LONG_COUNTRY_NAME_LEN+1];
	wchar_t		wszShortName[MAX_SHORT_COUNTRY_NAME_LEN+1];
	ULONG		ulCode;
} EMSCOUNTRYCODEINFO;
