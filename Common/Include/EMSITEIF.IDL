interface IEMSSystemTestSettings : IUnknown
{	

	typedef struct _tagEMSSYSTEMTESTINFO2
	{
		DWORD		dwFlags;
		WORD		wSwitchID;
		double	dThreshold;
		EMSAZEL 	azelTestHorn;
		EMSAZEL	azelSweepFrom;	
		EMSAZEL	azelSweepTo;
		double	dMinDuration;			// seconds required to perform system test
		double	dMaxModIndex;			// ModIndex must be less than this value
		double	dReserved1;
		LONG		lReserved2;
	} EMSSYSTEMTESTINFO2, *LPEMSSYSTEMTESTINFO2;

	HRESULT GetSystemTestInfo2( [ out ] EMSSYSTEMTESTINFO2 *lpInfo );
};

