cpp_quote( "// {3F29435D-64E3-4ef3-A759-138F984B85F1}" )
cpp_quote( "DEFINE_GUID(IID_IEMSDataTransmitter, 0x3f29435d, 0x64e3, 0x4ef3, 0xa7, 0x59, 0x13, 0x8f, 0x98, 0x4b, 0x85, 0xf1);" )



import "unknwn.idl";

[
	object, uuid(3F29435D-64E3-4ef3-A759-138F984B85F1),
	helpstring("IEMSDataTransmitter Interface"),
	pointer_default(unique)
]
interface IEMSDataTransmitter : IUnknown
{
	//! Connect to the destination.  Input is transmitter-specific connection data.  The string
	//! is in transmitter-defined format.
	HRESULT Connect( [in,string] const wchar_t* cwszConnectInfo );

	//! Release the connection to the destination.
	HRESULT Disconnect();

	//! Transmit the data in the supplied buffer.
	HRESULT Send( [in] const int ciLen, [in,size_is(ciLen)] const BYTE* cabyData, [in,out] int* piSent );
};