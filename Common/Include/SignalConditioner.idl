import "unknwn.idl";

[
	object, uuid(6BE73FF9-D6A0-42b5-8AFB-00659F791FB3),
	helpstring("IEMSSignalConditioner Interface"),
	pointer_default(unique)
]
interface IEMSSignalConditioner : IUnknown
{
	HRESULT Process( [in] const ULONG culBytes, [in,size_is(culBytes)] const char* cabyInData,
					[out] ULONG* pulBytes, [out,size_is(,*pulBytes)] char** pabyOutData );

	HRESULT Init( [in,string,unique] const wchar_t* cwszConfig );
};

[
	object, uuid(7636472C-776E-455f-9B55-43F5D19C33A4),
	helpstring("IEMSSCServer Interface"),
	pointer_default(unique)
]
interface IEMSSCServer : IUnknown
{
	HRESULT Process( [in] const ULONG culBytes, [in,size_is(culBytes)] const char* cabyInData );

	HRESULT ProcessEx( [in] const ULONG culBytes, [in,size_is(culBytes)] const char* cabyInData,
					[out] ULONG* pulBytes, [out,size_is(,*pulBytes)] char** pabyOutData );

	HRESULT Init( [in,string,unique] const wchar_t* cwszConfig );
};