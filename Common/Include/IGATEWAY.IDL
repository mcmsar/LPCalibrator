[
	object, 
	uuid(9C33E067-BB2A-48c2-809C-CF791705310A),
	helpstring("IEMSHealthStatusGtwy Interface"),
	pointer_default(unique)
]
interface IEMSHealthStatusGtwy : IUnknown
{	
	// A value of 0 for culSendStatusTo tells the software to send
	// the health status SIT message to all interested routes/destinations
	// Remember that culDestID is the destination for this request 
	// and not the ultimate destination for the data
	HRESULT SendHealthStatus(	[in] const unsigned long culDestID,
								[in] const EMSGATEWAYTOKEN* cpsecToken,
								[in] const EMSTRIGGER ceTrigger,
								[in] const unsigned long culSendStatusTo,
								[in] const EMSHEALTHSTATUS cStatus,
								[in] const unsigned long culRecCount,
								[in,size_is(culRecCount)] 
									const EMSHEALTHDETECTIONS* caDetectionRecords );
};


