	HRESULT GetSatBehaviourCount( [in] ULONG ulSatelliteID, [out] WORD *lpwCount );
	HRESULT GetSatBehaviour( [in] ULONG ulSatelliteID, [in] WORD wIndex, [out] EMSSATBEHAVIOUR *lpBehaviour );

	HRESULT SetSatOrbitInfoMaxCount( [in] ULONG ulSatelliteID, [in] WORD wCount );
	HRESULT SetSatOrbitInfoCount( [in] ULONG ulSatelliteID, [in] WORD wCount );
	HRESULT SetSatOrbitInfo( [in] ULONG ulSatelliteID, [in] WORD wIndex, [in] EMSSATORBITINFO *lpOrbit );

	HRESULT GetSatOrbitInfoMaxCount( [in] ULONG ulSatelliteID, [out] WORD *lpwCount );
	HRESULT GetSatOrbitInfoCount( [in] ULONG ulSatelliteID, [out] WORD *lpwCount );
