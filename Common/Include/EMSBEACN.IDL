cpp_quote("#define EMS_BEACON_USEREFFREQ           (0x0040)")
cpp_quote("#define EMS_BEACON_GEO_REFFREQ           (EMS_BEACON_USEREFFREQ)")
cpp_quote("#define EMS_BEACON_ACTIVE			    	(0x0020)")
cpp_quote("#define EMS_BEACON_TCAL				    	(0x0010)")
cpp_quote("#define EMS_BEACON_MCCSUPPRESS	    	   (0x0008)")
cpp_quote("#define EMS_BEACON_ORBITUPDATEFLAG    	(0x0004)")
cpp_quote("#define EMS_BEACON_CHECK_ACCURACY		(0x0002)")
cpp_quote("#define EMS_BEACON_USE_EE_ADJUST			(0x0001)")
