			EMSCOMBINE406DATA combine406;
		[ case( EMSRT_CONFIG ) ]
			EMSCONFIGPACKET config;
		[ case( EMSRT_LOCATE, EMSRT_LOCATE_124 ) ]
			EMSLOCATE locate;
		[ case( EMSRT_LOG ) ]
			EMSLOGDATA log;
		[ case( EMSRT_ORBIT ) ]
			EMSTLERECORD tle;
		[ case( EMSRT_RESIDUAL ) ]
			EMSRESIDUALDATA residual;
		[ case( EMSRT_SARP_CALIB, EMSRT_SARP_CALIB_124 ) ]
			EMSSARPCALIBDATA sarpcalib;
		[ case( EMSRT_SARP ) ]
			EMSSARPDATA sarp;
		[ case( EMSRT_SARR_CALIB ) ]
			EMSSARRCALIBDATA sarrcalib;
		[ case( EMSRT_SARR, EMSRT_SARR_124 ) ]
			EMSSARRDATA sarr;
		[ case( EMSRT_SAT_TRACK ) ]
			EMSSATTRACKRECORD satTrack;
		[ case( EMSRT_SPECTRUM ) ]
			EMSSPECTRUM spectrum;
		[ case( EMSRT_MANOEUVRE ) ]
			EMSMANOEUVREDATA manoeuvre;
		[ case( EMSRT_AUDIO ) ]
			EMSAUDIODATARECORD_RIFF audio;
		[ case( EMSRT_STAT_SUMMARY ) ]
			EMSALARMDATA statsummary;
		[ case ( EMSRT_SARR_EXT ) ]
			EMSSARRDATAEX sarrext;
		[ case ( EMSRT_CALIB406_EXT ) ]
			EMSCALIB406DATAEXT calib406ext;
		[ case ( EMSRT_CALIB406_2 ) ]
			EMSCALIB406DATA2 calib406_2;
		[ default ]
			;
	} data;
} EMSVARIANTRECORD2;


// Note that the EMSVARIANTRECORD3 has been added to support Data Transfer of a series of new
// data types:  ABL_DATA, HEALTH_STATUS, HEALTH_DETECTIONS, and BEACON_ADVISORY.
// DAL support is not being added at this time for querying and inserting.  That would require
typedef struct tagEMSVariantRecord3
{
	EMSRECORDTYPE eType;
	
	[switch_type(EMSRECORDTYPE), switch_is((EMSRECORDTYPE)eType)]
	union
	{
		[ case( EMSRT_ANTENNA,  
				EMSRT_CALIBCBC_STATS,
				EMSRT_COLLECTOR,
				EMSRT_COMB406_STATS,
				EMSRT_COMMS_STATS,
				EMSRT_GEO_CALIB406_STATS,
				EMSRT_GEO_STATS,
				EMSRT_LEO_CALIB406_STATS,
				EMSRT_LOCATE_STATS,
				EMSRT_ORBIT_STATS,
				EMSRT_PASS_STATS,
				EMSRT_SARR_CALIB_STATS,
				EMSRT_SARP_CALIB_STATS,
				EMSRT_SARP_CALIB_STATS_124,
				EMSRT_SENSOR,
				EMSRT_WIDEBAND_STATS,
				EMSRT_LUT_STATUS ) ]
			EMSLEOSTATUSUPDATE 	status;
		[ case( EMSRT_CALIB406 ) ]
			EMSCALIB406DATA calib406;
		[ case( EMSRT_CALIBCBC ) ]
			EMSCBCOUTPUTDATA calibCBC;
		[ case( EMSRT_CBC ) ]
			EMSCBCDATA rawCBC;
		[ case( EMSRT_COMB406 ) ]
			EMSCOMBINE406DATA combine406;
		[ case( EMSRT_CONFIG ) ]
			EMSCONFIGPACKET config;
		[ case( EMSRT_LOCATE, EMSRT_LOCATE_124 ) ]
			EMSLOCATE locate;
		[ case( EMSRT_LOG ) ]
			EMSLOGDATA log;
		[ case( EMSRT_ORBIT ) ]
			EMSTLERECORD tle;
		[ case( EMSRT_RESIDUAL ) ]
			EMSRESIDUALDATA residual;
		[ case( EMSRT_SARP_CALIB, EMSRT_SARP_CALIB_124 ) ]
			EMSSARPCALIBDATA sarpcalib;
		[ case( EMSRT_SARP ) ]
			EMSSARPDATA sarp;
		[ case( EMSRT_SARR_CALIB ) ]
			EMSSARRCALIBDATA sarrcalib;
		[ case( EMSRT_SARR, EMSRT_SARR_124 ) ]
			EMSSARRDATA sarr;
		[ case( EMSRT_SAT_TRACK ) ]
			EMSSATTRACKRECORD satTrack;
		[ case( EMSRT_SPECTRUM ) ]
			EMSSPECTRUM spectrum;
		[ case( EMSRT_MANOEUVRE ) ]
			EMSMANOEUVREDATA manoeuvre;
		[ case( EMSRT_AUDIO ) ]
			EMSAUDIODATARECORD_RIFF audio;
		[ case( EMSRT_STAT_SUMMARY ) ]
			EMSALARMDATA statsummary;
		[ case ( EMSRT_SARR_EXT ) ]
			EMSSARRDATAEX sarrext;
		[ case ( EMSRT_CALIB406_EXT ) ]
			EMSCALIB406DATAEXT calib406ext;
		[ case ( EMSRT_CALIB406_2 ) ]
			EMSCALIB406DATA2 calib406_2;
		[ case ( EMSRT_ABL_DATA ) ]
			EMSABLData abl;
		[ case ( EMSRT_HEALTH_STATUS ) ]
			EMSHEALTHSTATUS healthstatus;
		[ case ( EMSRT_HEALTH_DETECTIONS ) ]
			EMSHEALTHDETECTIONS healthdetections;
		[ case ( EMSRT_BEACON_ADVISORY ) ]
			EMS_BEACON_ADVISORY beaconadvisory;
		[ default ]
			;
	} data;
} EMSVARIANTRECORD3;


[
	uuid(F66FA79A-593B-414b-B024-934B3E91FA71),
	helpstring("IEMSDALVariable"),
	pointer_default(unique)
]
interface IEMSDALVariable : IUnknown
{
	HRESULT GetData(	[in,out] EMSDALCACHEID* pCacheID,
						[in] const unsigned long culMaxRecords,
						[in] const boolean cbReturnDescriptor,
						[in,string,unique] const wchar_t* cwszOutputFileSpec,
						[in,out] unsigned long* pulTotalRecords,
						[in,out] unsigned long* pulRecordSize,
						[in,out] boolean* pbCacheOverflow,
						[in,string,unique] const wchar_t* cwszConnection,
						[in,string,unique] const wchar_t* cwszSQLQuery,
						[in,out] unsigned long* pulFields,
						[out,size_is(,*pulFields)] EMSFIELDDESCRIPTOR** paFields,
						[in,out] unsigned long* pulDataSize,
						[out,size_is(,*pulDataSize)] unsigned char** paData );

	HRESULT Cancel( [in] const EMSDALCACHEID cCacheID );
};

[
	uuid(803BA197-4A48-4d01-B545-C56F660FDF1F),
	helpstring("IEMSDALFixed"),
	pointer_default(unique)
]
interface IEMSDALFixed : IUnknown
{
	HRESULT GetData(	[in] const EMSRECORDTYPE ceRecordType,
						[in,out] EMSDALCACHEID* pCacheID, 
						[in] const unsigned long culMaxRecords, 
						[in,out] unsigned long* pulTotalRecords, 
						[in,out] boolean* pbCacheOverflow, 
						[in,string,unique] const wchar_t* cwszConnection, 
						[in,string,unique] const wchar_t* cwszSQLWhere, 
						[in,out] unsigned long* pulRecords, 
						[out,size_is(,*pulRecords)] EMSVARIANTRECORD** paRecords );

	HRESULT Delete(	[in,string,unique] const wchar_t* cwszConnection, 
					[in] const EMSRECORDTYPE ceType, 
					[in] const EMSTIME ctimeStart, 
					[in] const EMSTIME ctimeEnd,
					[in,out] unsigned long* pulDeleted );

	HRESULT Insert( [in,string,unique] const wchar_t* cwszConnection, 
					[in] const unsigned long culRecords,
					[in,size_is(culRecords)] const EMSVARIANTRECORD* caRecords );

	HRESULT Cancel( [in] const EMSDALCACHEID cCacheID );
};

[
	uuid(228E8452-9AB1-4fb7-AC71-5212CC4ED9AA),
	helpstring("IEMSDALFixed2"),
	pointer_default(unique)
]
interface IEMSDALFixed2 : IEMSDALFixed
{
	HRESULT GetData2(	[in] const EMSRECORDTYPE ceRecordType,
						[in,out] EMSDALCACHEID* pCacheID, 
						[in] const unsigned long culMaxRecords, 
						[in,out] unsigned long* pulTotalRecords, 
						[in,out] boolean* pbCacheOverflow, 
						[in,string,unique] const wchar_t* cwszConnection, 
						[in,string,unique] const wchar_t* cwszSQLWhere, 
						[in,out] unsigned long* pulRecords, 
						[out,size_is(,*pulRecords)] EMSVARIANTRECORD2** paRecords );

	HRESULT Insert2( [in,string,unique] const wchar_t* cwszConnection, 
					[in] const unsigned long culRecords,
					[in,size_is(culRecords)] const EMSVARIANTRECORD2* caRecords );
};