import "unknwn.idl";
import "securitytoken.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

const ULONG EMS_MAX_USER_NAME = 21;

typedef struct _tagEMSAUTHORIZATIONINFO
{
	char szUserName[ EMS_MAX_USER_NAME ];
	ULONG ulRoleID; 
} EMSAUTHORIZATIONINFO, *LPEMSAUTHORIZATIONINFO;


[
	object, uuid(11C1D615-1625-4685-9DAC-40A086D237C8),
	helpstring("IEMSAuthorization Interface"),
	pointer_default(unique)
]

interface IEMSAuthorization : IUnknown
{
	HRESULT Authorize( [in] ULONG ulResourceID,
					   [in] EMSGATEWAYTOKEN *lpSecurityToken,
					   [out] EMSAUTHORIZATIONINFO* authorizationResult );
};

typedef [unique] IEMSAuthorization *LPEMSAUTHORIZATION;

