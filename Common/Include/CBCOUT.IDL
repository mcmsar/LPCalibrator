cpp_quote("#ifndef INC_CBCOUT")
cpp_quote("#define INC_CBCOUT")
cpp_quote("")

import "unknwn.idl";
import "emstypex.idl";
import "sigdata.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(DFA5F291-EDBF-11d5-8D2C-009027912866),
	helpstring("IEMSCBCOUTPUTdata"),
	pointer_default(unique)
]

interface IEMSCBCOUTPUTdata
{
#pragma pack(1)

typedef struct _tagEMSCBCOUTPUTDATA
{
	EMSSIGDATAIDTYPE	hdr;				// time, ulSatID, ulLutID, wType
	ULONG			ulPassID;
	INT64			i64CalibID;				// ID of calibration process
	ULONG			ulSeqNumber;
	double		dFrequency;				// Frequency in Hz ( corrected )
	float			fFreqOffset;			// Frequency offset in Hz (satellite/ground station dependency)
	float			fFreqAccuracy;			// Hz
	float			fPower;					// relative power measurement
	float			fSweepPeriod;			// repetition time of the ELT signal
	float			fSweepSpan;				// freq span of the ELT signal
	float			fSweepCorrelation;		// relative power measurement
	INT64			i64TcaIE;           // initial TCA estimate ( nanoseconds from Jan 1, 1970 )
	float			fBiasIE;            // initial bias estimate ( Hz )
	float			fCtaIE;			    // initial CTA estimate ( degrees )
} EMSCBCOUTPUTDATA, *LPEMSCBCOUTPUTDATA;

#pragma pack()
}

cpp_quote("#endif // INC_CBCOUT")


