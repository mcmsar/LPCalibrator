cpp_quote( "DEFINE_GUID( IID_IEMSResource, 0xcf4c1c58, 0x29e0, 0x4c6e, 0x89, 0x30, 0xb5, 0xde, 0xba, 0xaf, 0x67, 0xd3); ")
cpp_quote( " " )

import "unknwn.idl";
import "emspipe.idl";
import "dal.idl";

//#define _EMS_RPC_VERSION 1


[
	object, uuid(CF4C1C58-29E0-4c6e-8930-B5DEBAAF67D3),
	helpstring("IEMSResource Interface"),
	pointer_default(unique)
]
interface IEMSResource : IUnknown
{
	typedef enum _tagModes
	{
		RES_OPEN_MODE_UNKNOWN = 0,
		RES_OPEN_MODE_READ = 1,
		RES_OPEN_MODE_WRITE = 2
	} EMSRESOURCEOPENMODE;

	HRESULT IsReadOnly( [out] BOOL* pbReadOnly );

	HRESULT IsActive( [out] BOOL* pbActive );

	HRESULT SetURL( [in,string] const wchar_t* cwszURL );

	HRESULT SetMode( [in] const EMSRESOURCEOPENMODE ceMode );

	HRESULT SetEventName( [in,string] const wchar_t* cwszEventName );

	HRESULT GetStream( [out] IEMSSeqStream** ppStream );

	HRESULT Activate( void );

	HRESULT Deactivate( void );

	HRESULT GetMetaData( [in,out] unsigned long* pulFields,
						[out,size_is(,*pulFields)] EMSFIELDDESCRIPTOR** paFields );

};