cpp_quote("#ifndef INC_SARPCALIB")
cpp_quote("#define INC_SARPCALIB")

import "unknwn.idl";
import "emstypex.idl";
import "sigdata.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(3C84A020-BDEA-4242-920B-A80AAE93E7B9),
	helpstring("IEMSSARPCALIBData Interface"),
	pointer_default(unique)
]

interface IEMSSARPCALIBData
{
#pragma pack(1)

	typedef struct _tagEMSSARPCALIBDATA
	{
		EMSSIGDATAID				hdr;					// time, ulSatID, ulLutID 
		ULONG							ulPassID;
		WORD							wSource;
		EMSTIME						timeEffective;
		ULONG							ulTCALNumber;
		EMSTIME						timeRollover;
		double						dUSOFrequency;
	} EMSSARPCALIBDATA, *LPEMSSARPCALIBDATA;

#pragma pack()
};

cpp_quote("#endif // INC_SARPCALIB")


