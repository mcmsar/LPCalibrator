import "unknwn.idl";
import "emsresource.idl";

[
	object, uuid(D67CB999-A4C3-4f18-A593-C4CB4C4DD842),
	helpstring("IEMSDataFormatter Interface"),
	pointer_default(unique)
]
interface IEMSDataFormatter : IUnknown
{
	HRESULT SetMethod( [in,string] const wchar_t* cwszMethod );

	HRESULT SetResource( [in] IEMSResource* pResource );

	HRESULT SetStartOffset( [in] const ULONG culOffset );

	HRESULT GetOutputRecordSize( [out] ULONG* pulValue );

	HRESULT GetStream( [out] IEMSSeqStream** ppStream );
	
};