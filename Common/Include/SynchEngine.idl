cpp_quote("// {F424A67C-2DC9-4b11-B653-FE052CB7DB47}")
cpp_quote("DEFINE_GUID(IID_IEMSSynchEngine,0xf424a67c, 0x2dc9, 0x4b11, 0xb6, 0x53, 0xfe, 0x5, 0x2c, 0xb7, 0xdb, 0x47);")


import "unknwn.idl";

[
	uuid(F424A67C-2DC9-4b11-B653-FE052CB7DB47),
	helpstring("IEMSDataStoreSynch"),
	pointer_default(unique)
]
interface IEMSSynchEngine : IUnknown
{
	HRESULT ConfigureSynchService( [in,string] const wchar_t* cwszAllSynchConfig );

	HRESULT SynchAll();

	HRESULT Synch( [in,string] const wchar_t* cwszSynchName );

	HRESULT GetSynchList( [out,string] wchar_t** pwszSynchList );

	HRESULT AddSynch( [in,string] const wchar_t* cwszSynchConfig );

	HRESULT DeleteSynch( [in,string] const wchar_t* cwszSynchName );

	HRESULT UpdateSynch( [in,string] const wchar_t* cwszSynchName );

	HRESULT GetSynch( [in,string] const wchar_t* cwszSynchName,
	                  [out,string] wchar_t** pwszSynchConfig );

}
