import "unknwn.idl";
import "emstypex.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

typedef const enum
{
	EMSLogMsgMoreFlag = 0x80,
	EMSLogMsgTrace = 0, 
	EMSLogMsgDebug = 1, 
	EMSLogMsgStatus = 2, 
	EMSLogMsgMoreStatus = ( EMSLogMsgStatus + EMSLogMsgMoreFlag ), 
	EMSLogMsgInfo = 3, 
	EMSLogMsgWarn = 4,
	EMSLogMsgAlarm = 5, 
	EMSLogMsgFatal = 6,
	EMSLogMsgStartup = 7
} EMSLOGMSGTYPE;

cpp_quote(" ")
cpp_quote("//*** Note that the ReportLogEvent methods belong to the deprecated interfaces.")
cpp_quote("//*** Use Report() instead.")
cpp_quote(" ")
cpp_quote("#ifdef UNICODE")
cpp_quote("#define ReportLogEvent     ReportLogEventW")
cpp_quote("#else")
cpp_quote("#define ReportLogEvent     ReportLogEventA")
cpp_quote("#endif // UNICODE")

[
	object, uuid(73FF4562-01F2-11d6-8D67-009027912866),
	helpstring("IEMSLeo600Logger Interface"),
	pointer_default(unique)
]
interface IEMSLeo600Logger : IUnknown
{	
	HRESULT Initialize( [in] ULONG ulLutID, [in] WORD wProcessID );

	HRESULT ReportLogEventW( [in] EMSLOGMSGTYPE msgType , [in] DWORD dwEvent ,
		[in, size_is( ulLength )] LPWSTR const lpszStrings,
		[in] ULONG ulLength );
	
	HRESULT ReportLogEventA( [in] EMSLOGMSGTYPE msgType , [in] DWORD dwEvent,
		[in, size_is( ulLength )] LPSTR const lpszStrings,
		[in] ULONG ulLength );
};

[
	object, uuid(50C0ED6D-39DE-4751-B0C1-CCAFA14AD41D),
	helpstring("IEMS600Logger Interface"),
	pointer_default(unique)
]

interface IEMS600Logger : IEMSLeo600Logger
{	
	HRESULT SetRaceSuppressionInterval( [in] double dSeconds );
};

