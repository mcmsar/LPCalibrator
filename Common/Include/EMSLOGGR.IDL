[
	object, uuid(A6C83E4F-B831-417d-8A9C-0FEF53C4182C),
	helpstring("IEMS600LoggerEx Interface"),
	pointer_default(unique)
]
interface IEMS600LoggerEx : IEMS600Logger
{	
	HRESULT Init( [in] ULONG ulLutID, [in] WORD wProcessID );
	HRESULT Report( 
		[in] const EMSLOGMSGTYPE	msgType , 
		[in] const DWORD			dwEventStringID,
		[in] const WORD				wParamCount, 
		[in, string, size_is(wParamCount)] const wchar_t** awszParams );
	HRESULT RaceSuppressionInterval( [in] double dSeconds );
};
typedef [unique] IEMS600LoggerEx *LPEMSLOGGER;
typedef [unique] IEMS600LoggerEx *LPEMS600LOGGER;

