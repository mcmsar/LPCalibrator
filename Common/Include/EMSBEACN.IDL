cpp_quote("#define EMS_BEACON_BEACONTYPE_REF       (0x0200)")
cpp_quote("#define EMS_BEACON_BEACONTYPE_TEST      (0x0400)")
cpp_quote("#define EMS_BEACON_BEACONTYPE_121       (0x0800)")
cpp_quote("#define EMS_BEACON_BEACONTYPE_243       (0x1000)")
cpp_quote("#define EMS_BEACON_BEACONTYPE_406	   (0x2000)")
