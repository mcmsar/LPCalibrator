cpp_quote("// {C6D6C252-FD77-4f2a-B478-371B0D2F626C}")
cpp_quote("DEFINE_GUID(IID_IEMSBeaconDecoder, 0xc6d6c252, 0xfd77, 0x4f2a, 0xb4, 0x78, 0x37, 0x1b, 0xd, 0x2f, 0x62, 0x6c);")

import "unknwn.idl";
import "emsbeacontype.h";
import "emstypex.idl";

[
	uuid(C6D6C252-FD77-4f2a-B478-371B0D2F626C),
	helpstring("IEMSBeaconDecoder"),
	pointer_default(unique)
]
interface IEMSBeaconDecoder : IUnknown
{
	HRESULT GetBeaconID( [in,string] const char* cszBeaconData, [out] INT64* pi64BeaconID );

	typedef struct tagBeaconLocation
	{
		INT64 i64BeaconID;
		BOOL bHasGPSLocation;
		double dLat;
		double dLong;
	} EMSBEACONLOCATION;

	HRESULT GetBeaconLocation( [in,string] const char* cszBeaconData, [out] EMSBEACONLOCATION* pstrLocation );

	HRESULT GetBeaconType( [in,string] const char* cszBeaconData, [out] EMSBEACONTYPE* peBeaconType );
}
