import "unknwn.idl";
import "emstypex.idl";
import "emsicfg.idl";
import "netconnmgr.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

	typedef struct _tagEMSREPLICATEINFO
	{
		DWORD dwFlags;
		double dFrequency;		// Frequency of replication ( hrs )
	} EMSREPLICATEINFO, *LPEMSREPLICATEINFO;

	#define EMS_MAX_COUNTRY_CODES		( 32 )
	#define EMS_MAX_USER_TYPES			( 32 )
	#define EMS_MAX_ALLOWRESERVE_COUNT	( 32 )

	typedef struct _tagEMSRETRYINFO
	{
		double dCheckMinutes;
		double dRetryMinutes;
		int	nRetryLimit;
	} EMSRETRYINFO, *LPEMSRETRYINFO;

	typedef struct _tagEMSFILTERINFO
	{
		DWORD dwFlags;
		ULONG ulMaxBCHErrors;
		int 	nCountryCodesCount;
		ULONG	ulCountryCodes[ EMS_MAX_COUNTRY_CODES ];	
		int 	nUserTypeCount;
		ULONG	ulUserTypes[ EMS_MAX_USER_TYPES ];	
	} EMSFILTERINFO, *LPEMSFILTERINFO;

	typedef struct _tagEMSABLFILTERINFO
	{
		DWORD	dwFlags;
		ULONG	ulCountryCode;
		short	sAllowReservedCount;
		short	asAllowReserved[ EMS_MAX_ALLOWRESERVE_COUNT ];
	} EMSABLFILTERINFO, *LPEMSABLFILTERINFO;

cpp_quote("// dwFlags ")
cpp_quote("#define EMS_SYSTEST_ON_PREPASS	( 0x0000001 )")
cpp_quote("#define EMS_SYSTEST_ON_STARTUP	( 0x0000002 )")
cpp_quote("#define EMS_SYSTEST_AVOID_CONFLICT ( 0x0000004 )")
cpp_quote(" ")

	typedef struct _tagEMSSYSTEMTESTINFO
	{
		DWORD		dwFlags;
		WORD		wSwitchID;
		double	dThreshold;
		EMSAZEL 	azelTestHorn;
		EMSAZEL	azelSweepFrom;	
		EMSAZEL	azelSweepTo;
		double	dMinDuration;			// seconds required to perform system test
	} EMSSYSTEMTESTINFO, *LPEMSSYSTEMTESTINFO;

	typedef struct _tagEMSAGCINFO
	{
		DWORD		dwFlags;
		WORD		wSwitchID;
	} EMSAGCINFO, *LPEMSAGCINFO;

   const DWORD c_dwDefaultAGCFlags = 0;
   const WORD c_wDefaultAGCSwitchID = 24;

	const unsigned short EMS_ROUTE_MAX_PATHLEN         = 256;
	const unsigned short EMS_ROUTE_SHORT_NAMELEN       = 8;
	const unsigned short EMS_ROUTE_LONG_NAMELEN        = 256;
	const unsigned short EMS_ROUTE_SIT_LIST_LENGTH     = 256;
	const unsigned short EMS_ROUTE_FILTER_LIST_LENGTH  = 256;

	typedef enum _tagEMSROUTEDIRECTION
	{
		EMS_RD_Unknown = 0,
		EMS_RD_Outbound = 1, 
		EMS_RD_Inbound = 2 
	} EMSROUTEDIRECTION;

	typedef enum _tagEMSROUTEMSGFMT
	{
		EMS_RMF_Unknown = 0,
		EMS_RMF_Sit = 1,
		EMS_RMF_MultiSit = 2
	} EMSROUTEMSGFMT;

	typedef enum _tagEMSROUTECOMMTYPE
	{
		EMS_RCT_Unknown = 0,
		EMS_RCT_Direct = 1,
		EMS_RCT_FTP = 2,
		EMS_RCT_TCPIP = 3
	} EMSROUTECOMMTYPE;

	typedef struct _tagEMSROUTEDIRINFO
	{
		char szPath[ EMS_ROUTE_MAX_PATHLEN ];
	} EMSROUTEDIRINFO, *LPEMSROUTEDIRINFO;

	typedef struct _tagEMSROUTEFTPINFO
	{
		int nPort;
		char szHost[64];
		char szLogin[64];
		char szPassword[64];
		char szPath[ EMS_ROUTE_MAX_PATHLEN ];
	} EMSROUTEFTPINFO, *LPEMSROUTEFTPINFO;

	const unsigned long  EMS_MAX_SIT_MSG_NUMBERS = 64;
	const unsigned long  EMS_TRANS_TABLE_NAMELEN = 32;

	typedef struct _tagEMSSITTRANSTABLE
	{
		int		nCounts;
		char	szName[EMS_TRANS_TABLE_NAMELEN];
		DWORD	dwCode[EMS_MAX_SIT_MSG_NUMBERS];
		DWORD	dwSit[EMS_MAX_SIT_MSG_NUMBERS];
	} EMSSITTRANSTABLE, *LPEMSSITTRANSTABLE;


	typedef struct _tagEMSSITMSGLIST
	{
		int nCount;
		DWORD dwSitCodes [ EMS_MAX_SIT_MSG_NUMBERS ];
		int	nSitNumbers[ EMS_MAX_SIT_MSG_NUMBERS ];
	} EMSSITMSGLIST, *LPEMSSITMSGLIST;

	typedef struct _tagEMSROUTEINFO
	{
		EMSROUTECOMMTYPE	commType;
		DWORD					dwFlags;
		EMSROUTEMSGFMT		msgFmt;
		EMSROUTEDIRECTION direction;
		EMSSITMSGLIST		sitMsgs;
		EMSRETRYINFO		retry;
		char szShortName[ EMS_ROUTE_SHORT_NAMELEN ];
		char szLongName[ EMS_ROUTE_LONG_NAMELEN ];
		char szFilterList[ EMS_ROUTE_FILTER_LIST_LENGTH ];
    [switch_type(EMSROUTECOMMTYPE), switch_is((EMSROUTECOMMTYPE)commType)]
		union
		{
			[case(EMS_RCT_FTP)]
				EMSROUTEFTPINFO ftp;
			[case(EMS_RCT_Direct)]
				EMSROUTEDIRINFO dir;
			[default]
				;
		} info;
	} EMSROUTEINFO, *LPEMSROUTEINFO;

	typedef struct _tagEMSDESTINATIONINFO
	{
		DWORD				dwFlags;
		ULONG				ulSeqNumber;
		ULONG				ulID;
		EMSRETRYINFO		retry;
		char 				szShortName[ EMS_ROUTE_SHORT_NAMELEN ];
		EMSROUTEMSGFMT		msgFmt;
		EMSSITMSGLIST		sitMsgs;
		EMSFILTERINFO		filterInfo;
		int					nRouteIndex;
		int					nTransIndex;
	} EMSDESTINATIONINFO, *LPEMSDESTINATIONINFO;

	typedef struct _tagEMSDESTINATIONINFO2
	{
		DWORD				dwFlags;
		ULONG				ulSeqNumber;
		ULONG				ulRouteIdentifier;
		ULONG				ulID;
		EMSRETRYINFO		retry;
		char 				szShortName[ EMS_ROUTE_SHORT_NAMELEN ];
		char 				szSrcShortName[ EMS_ROUTE_SHORT_NAMELEN ];
		EMSROUTEMSGFMT		msgFmt;
		EMSSITMSGLIST		sitMsgs;
		EMSFILTERINFO		filterInfo;
		int					nRouteIndex;
		int					nTransIndex;
	} EMSDESTINATIONINFO2, *LPEMSDESTINATIONINFO2;

	typedef struct _tagEMSDESTINATIONINFO3
	{
		EMSDESTINATIONINFO2	info2;
		EMSABLFILTERINFO	ablFilterInfo;
	} EMSDESTINATIONINFO3, *LPEMSDESTINATIONINFO3;

	typedef struct _tagEMSSOURCEINFO
	{
		DWORD				dwFlags;
		ULONG				ulSeqNumber;
		ULONG				ulID;
		EMSRETRYINFO		retry;
		char 				szShortName[ EMS_ROUTE_SHORT_NAMELEN ];
		int					nRouteIndex;
	} EMSSOURCEINFO, *LPEMSSOURCEINFO;

   const DWORD c_dwDefaultSourceInfoFlags = 0;

	typedef struct _tagEMSSERVICEINFO
	{
		char		szName[32];
		WORD		wFlags;		
	} EMSSERVICEINFO, *LPEMSSERVICEINFO;

[
	object, uuid(C28EB166-045F-4d3f-AABB-D9E3A83D3529),
	helpstring("IEMSSiteInfo Interface"),
	pointer_default(unique)
]

interface IEMSSiteInfo : IEMSConfigSettings
{	
	HRESULT GetLutID( [out] ULONG *lpulLutID );

	HRESULT GetLutName( [out, size_is(cb), length_is(*pcbLength)]	char *pv,
						[in] ULONG cb,	[out] ULONG *pcbLength );

	HRESULT GetSecondaryLuts( 
		[out, size_is(ulMax), length_is(*ulActual)]	ULONG *lpulLuts,
		[in] ULONG ulMax,	[out] ULONG *ulActual );

	HRESULT GetServiceInfo( 
		[out, size_is(ulMax), length_is(*ulActual)]	EMSSERVICEINFO *lpInfo,
		[in] ULONG ulMax,	[out] ULONG *ulActual );

	HRESULT GetMonitorFrequency( [out] ULONG *lpulFrequency );

	HRESULT GetGuardFrequency( [out] ULONG *lpulFrequency );


	HRESULT  GetTranslationTableInfo( 
		[out, size_is(ulMax), length_is(*ulActual)] EMSSITTRANSTABLE *lpInfo,
		[in] ULONG ulMax, [out] ULONG *ulActual );

	HRESULT GetRouteInfo( 
		[out, size_is(ulMax), length_is(*ulActual)]	EMSROUTEINFO *lpInfo,
		[in] ULONG ulMax,	[out] ULONG *ulActual );

	HRESULT GetDestinationsInfo( 
		[out, size_is(ulMax), length_is(*ulActual)]	EMSDESTINATIONINFO *lpInfo,
		[in] ULONG ulMax,	[out] ULONG *ulActual );

	HRESULT GetSourcesInfo( 
		[out, size_is(ulMax), length_is(*ulActual)]	EMSSOURCEINFO *lpInfo,
		[in] ULONG ulMax,	[out] ULONG *ulActual );

	HRESULT GetDataDirectory( [out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
						[in] ULONG cb,	[out] ULONG *pcbRead );

	HRESULT GetRecvMsgDirectory( [out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
						[in] ULONG cb,	[out] ULONG *pcbRead );

	HRESULT GetProcessedMsgDirectory( [out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
						[in] ULONG cb,	[out] ULONG *pcbRead );

	HRESULT GetSendMsgDirectory( [out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
						[in] ULONG cb,	[out] ULONG *pcbRead );

	HRESULT GetSentMsgDirectory( [out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
						[in] ULONG cb,	[out] ULONG *pcbRead );

	HRESULT GetUndeliveredMsgDirectory( [out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
						[in] ULONG cb,	[out] ULONG *pcbRead );

	HRESULT SetRecvdMsgNumber( [ in, string ] char *lpszShortRouteName, [in] ULONG ulMsgNumber );

	HRESULT SetSentMsgNumber( [ in, string ] char *lpszShortRouteName, [in] ULONG ulMsgNumber );

	HRESULT GetGpsAllowedDifference( [ out ] double *lpdSeconds );

	HRESULT GetGpsCheckFrequency( [ out ] double *lpdSeconds );

	HRESULT GetSystemTestInfo( [ out ] EMSSYSTEMTESTINFO *lpInfo );

	HRESULT GetReplicationInfo( [ out ] EMSREPLICATEINFO *lpInfo );

	HRESULT GetAGCInfo( [ out ] EMSAGCINFO *lpInfo );
};

typedef [unique] IEMSSiteInfo *LPEMSSITEINFO;

