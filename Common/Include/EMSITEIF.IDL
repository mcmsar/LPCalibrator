interface IEMSRouteInfo : IUnknown
{
	cpp_quote("#define EMS_MAX_CONNECTION_LEN 255")
	#define EMS_MAX_CONNECTION_LEN 255

	cpp_quote("#define EMS_MAX_CONNECTIONS 8")
