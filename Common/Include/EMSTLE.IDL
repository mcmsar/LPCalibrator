cpp_quote("#ifndef INC_EMSTLE")
cpp_quote("#define INC_EMSTLE")
cpp_quote(" ")
cpp_quote("#define EMS_TLE_MORE_SAT_FLAG ( 0x80000000 )")

import "unknwn.idl";
import "emstypex.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 


[
	uuid(F83F4B73-EA53-11d5-8D21-009027912866),
	helpstring("IEMSTLEdata"),
	pointer_default(unique)
]

interface IEMSTLEdata
{
	#pragma pack(1)

	typedef struct _tagEMSTLERECORD
	{
		EMSTIME		time;			//	timeModified
		ULONG			ulLutID;	
		ULONG			ulSatID;
		int 			nOrbitNumber;
		EMSTIME		timeEpoch;
		double 		fXndt2o;
		double 		fXndd6o;	  	// has exponent included
		double 		fBStar;		// has exponent included
		double 		fInclination;
		double 		fRightAscNode;
		double 		fEccentricity;
		double 		fArgPerigee;
		double 		fMeanAnomaly;
		double 		fMeanMotion;
		double 		fCoVarMatrix[ 21 ];
		EMSTIME		timeEffective;
		double		dVelocityDifference;
		double		dRadiusDifference;
	} EMSTLERECORD, *LPEMSTLERECORD;

#pragma pack()
}

cpp_quote("#endif //INC_EMSTLE")


