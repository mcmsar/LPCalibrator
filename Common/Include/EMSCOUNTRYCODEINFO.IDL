cpp_quote("#define MAX_COUNTRY_CODE_VALUE 780 ")
cpp_quote(" ")

typedef enum _tagCOUNTRYNAMETYPE
{
	COUNTRYNAME_MIN = 0,
	COUNTRYNAME_UNKNOWN = 0,
	COUNTRYNAME_LONG = 1,
	COUNTRYNAME_SHORT = 2,
	COUNTRYNAME_MAX = 3
} COUNTRYNAMETYPE;
cpp_quote("#define VALID_COUNTRYNAMETYPE(x) (COUNTRYNAME_MIN <= x && COUNTRYNAME_MAX >= x)")
cpp_quote(" ")

[
	object, uuid(C40A2427-F7BC-4671-9CEF-C16B136024C0),
	helpstring("IEMSCountryCodeInfo Interface"),
	pointer_default(unique)
]

interface IEMSCountryCodeInfo : IEMSConfigSettings
{
	HRESULT GetCountryName(	[in]  const ULONG culCode,
							[in]  const COUNTRYNAMETYPE ceNameType,
							[out] BSTR  *pbszName);


	HRESULT IsValidCountryCode( [in]  const ULONG culCode,
								[out] BOOL *pbValid );

};

