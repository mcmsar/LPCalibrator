	HRESULT GetReceivingProcessID( [out] DWORD* pdwProcessID );
};

[ 
	object, uuid(488E3133-7AD3-11d5-8BFD-009027912866),
	pointer_default(unique)
]

interface IEMSDataPipeline : IUnknown
{
	typedef [unique] IEMSDataPipeline *LPEMSDATAPIPELINE;

	typedef struct _tagEMSDATACHANNELINFO
	{
		BOOL		bValidChannel;
		WORD		wMaxSinks;
		WORD		wSinks;
		WORD		wMaxSources;
		WORD		wSources;
		WORD		wMaxBuffers;
		WORD		wHighBuffers;			// Highest number of buffered records
		WORD		wLowBuffers;			// Lowest number of buffered records
		DWORD		dwMaxLength;
		DWORD		dwFlags;
		HRESULT		errLatest;				
	} EMSDATACHANNELINFO, *LPEMSDATACHANNELINFO;

	HRESULT SetInfo( [in] DWORD dwInfo );
	HRESULT GetInfo( [out] DWORD *lpdwInfo );
	HRESULT GetChannelInfo( [in] BYTE cType, [out] EMSDATACHANNELINFO *lpInfo );

	HRESULT SetFlags( [in] BYTE cType, [in] DWORD dwFlags );
	HRESULT GetFlags( [in] BYTE cType, [out] DWORD *lpdwFlags );
	HRESULT SetMaxLength( [in] BYTE cType, [in] INT nMaxLength );
	HRESULT GetMaxLength( [in] BYTE cType, [out] INT *lpnMaxLength );
	HRESULT SetMaxSinks( [in] BYTE cType, [in] INT nMaxSinks );
	HRESULT GetMaxSinks( [in] BYTE cType, [out] INT *lpnMaxSinks );
	HRESULT SetMaxSources( [in] BYTE cType, [in] INT nMaxSources );
	HRESULT GetMaxSources( [in] BYTE cType, [out] INT *lpnMaxSources );

	HRESULT RegisterSink( [in] LPEMSDATASINK lpSink );
	HRESULT UnRegisterSink( [in] LPEMSDATASINK lpSink );
	HRESULT RegisterSource( [in] LPEMSDATASOURCE lpSource );
	HRESULT UnRegisterSource( [in] LPEMSDATASOURCE lpSource );
};

