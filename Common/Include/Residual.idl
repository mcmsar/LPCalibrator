cpp_quote("#ifndef INC_RESIDUAL")
cpp_quote("#define INC_RESIDUAL")
cpp_quote("")

import "unknwn.idl";
import "emstypex.idl";
import "sigdata.idl";


#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(AA59E291-EB65-11d6-9FE7-00902766CA99),
	helpstring("IEMSRESIDUALdata"),
	pointer_default(unique)
]


interface IEMSRESIDUALdata
{
	#pragma pack(1)

typedef struct  _tagEMSDRESIDUALDATA
    {

    ULONG    ulReferenceID;
    EMSSIGDATAIDTYPE hdr;
    INT64    i64BeaconID;
    ULONG    ulSatPassID;
    EMSTIME  timeMsg;
    INT64    i64TimeOffset;
    float    fLutSatTimeOffset;
    double   dMeasurement;
    float    fFreqOffset;
    float    fLutSatFreqOffset;
    double   dPower;
    WORD     wProcessFlag;
    double   dResidual;
    WORD     wProcessFlags[4];
    double   dResiduals[4];

    EMSSIGDATAIDTYPE hdr1;
    EMSSIGDATAIDTYPE hdr2;
    EMSTIME  timeMsg2;
    INT64    i64TimeOffset2;
    float    fLutSatTimeOffset2;
    double   dMeasurement2;
    float    fFreqOffset2;
    float    fLutSatFreqOffset2;
    double   dPower2;

    }	EMSDRESIDUALDATA;

typedef struct _tagEMSDRESIDUALDATA __RPC_FAR *LPEMSDRESIDUALDATA;

typedef struct _tagEMSRESIDUALDATA
{
	EMSSIGDATAIDTYPE	hdr;			// time, ulSatID, ulLutID, wType
	ULONG		ulSatPassID;			// Satellite pass number
	ULONG		ulReferenceID;			// Reference number assigned to match Location or Orbit Determination

	INT64		i64BeaconID;			// Beacon ID
	EMSTIME		timeMsg;				// encoded msg time
	double 		dMeasurement;			// Received Frequency (or FDOA) in Hz or TDOA in microsec
	float		fResidual;				// Measurement residual in Hz or microsec
	float		fPower;					// Measurement power estimate in dBm
	WORD		wProcessFlag;			// Process flag ( 1 = used, 0 = not used )
	
	} EMSRESIDUALDATA, *LPEMSRESIDUALDATA;

#pragma pack()
}

cpp_quote("#endif //INC_RESIDUAL")
