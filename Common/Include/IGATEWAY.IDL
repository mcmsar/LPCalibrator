[
	object, 
	uuid(11CA4B54-7D62-45a2-9620-052049A3AA39),
	helpstring("IEMSLocationGtwy Interface"),
	pointer_default(unique)
]
interface IEMSLocationGtwy : IUnknown
{
	typedef enum tagManualProcessingMode
	{
		EMS_MANUAL_MODE_UNKNOWN = 0,
		EMS_MANUAL_MODE_LEO_ONLY = 1,
		EMS_MANUAL_MODE_LEO_GEO = 2,
		EMS_MANUAL_MODE_LEO_GEO_COMBINED = 3,
		EMS_MANUAL_MODE_LAST = EMS_MANUAL_MODE_LEO_GEO_COMBINED
	} EMSMANUALPROCESSINGMODE;

	// Manual CLOP Processing
	HRESULT InitManualProcessing(	[in] unsigned long ulDestID,
									[in] EMSGATEWAYTOKEN* pToken,
									[in,string] wchar_t* wszWhereClause,
									[out] unsigned long* pulSessionID,
									[in,out] unsigned long* pulRecords,
									[out,size_is(,*pulRecords)] EMSCALIB406DATA** paBeaconData );

	HRESULT RemoveDataFromSet(	[in] unsigned long ulDestID,
								[in] EMSGATEWAYTOKEN* pToken,
								[in] unsigned long ulSessionID,
								[in] unsigned long ulKeys,
								[in,size_is(ulKeys)] unsigned long* aulKeys );

	HRESULT	Process406(	[in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] unsigned long ulSessionID,
						[in,string] wchar_t* wszControlFilename,
						[in,out] unsigned long* pulResults,
						[out,size_is(,*pulResults)] EMSLOCATE** paLocations );

	HRESULT CancelSession(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] unsigned long ulSessionID );

	HRESULT GetControlFilenames(	[in] unsigned long ulDestID,
									[in] EMSGATEWAYTOKEN* psecToken, 
									[out] unsigned long* pulCount,
									[out, string, size_is(, *pulCount)] wchar_t***  ppaControlFilenames );

	HRESULT InitManual(	[in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* pToken,
						[in,string] const wchar_t* cwszWhereClause,
						[in] const EMSMANUALPROCESSINGMODE ceProcessingMode,
						[out] unsigned long* pulSessionID,
						[in,out] unsigned long* pulRecords,
						[out,size_is(,*pulRecords)] EMSVARIANTRECORD** paData );

};


[
	object, 
	uuid(EF7FD937-6AC3-4dd6-98C9-C255117542F5),
	helpstring("IEMSAlertGenGtwy Interface"),
	pointer_default(unique)
]
interface IEMSAlertGenGtwy : IUnknown
{
	// Alert Generator
	HRESULT GenerateAlerts(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] unsigned long ulDestinations,
							[in,size_is(ulDestinations)] unsigned long* aulDestinationIDs,
							[in] unsigned long ulLocations,
							[in,size_is(ulLocations)] EMSLOCATIONKEY* aLocations );
};

[
	object, 
	uuid(EC92FCFC-7E9D-4b5b-88E6-BC7587FF0668),
	helpstring("IEMSAlertManagerGtwy Interface"),
	pointer_default(unique)
]
interface IEMSAlertManagerGtwy : IUnknown
{
	const unsigned long MAX_ALERT_RECORDS = 2;	// A solution can have maximum two EMSLOCATE records (an A side and a B side).
	
	// A value of 0 for ulSolutionDestination tells the software
	// to send the solution to all interested routes/destinations
	// This value also indicates that the software should accumulate solutions 
	// until the sit message reaches maximum size or until TransmitAutoAlerts() is called
	HRESULT SendSolution(	[in] unsigned long ulDestID,  // identifies the LUT where this request is to be processed
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulSolutionDestination, 
							[in] unsigned long ulSatID,
							[in] unsigned long ulPassID,
							[in] EMSLOCATE aLocations[MAX_ALERT_RECORDS],
							[in] char szUserID[ EMS_MAX_USER_NAME ] ); // Used for logging

	// Send accumulated alert data now
	HRESULT TransmitAutoAlerts( [in] unsigned long ulDestID,
								[in] EMSGATEWAYTOKEN* psecToken,
								[in] EMSTRIGGER eTrigger );
};

[
	object, 
	uuid(1E29E10B-804F-4e3f-AEA1-0CB7939C1459),
	helpstring("IEMSAlertManagerGtwy2 Interface"),
	pointer_default(unique)
]
interface IEMSAlertManagerGtwy2 : IEMSAlertManagerGtwy
{
	// Same as SendSolution() but the software ensures that resulting sit messages are sent immediately
	HRESULT SendSolutionNow(	[in] const unsigned long culDestID, // identifies the LUT where this request is to be processed
								[in] const EMSGATEWAYTOKEN* cpsecToken,
								[in] const EMSTRIGGER ceTrigger,
								[in] const unsigned long culSolutionDestination,
								[in] const unsigned long culSatID,
								[in] const unsigned long culPassID,
								[in] const EMSLOCATE caLocations[MAX_ALERT_RECORDS],
								[in] const char cszUserID[ EMS_MAX_USER_NAME ] );
};

[
	object, 
	uuid(EB381D22-7D01-40aa-89B3-6BB8F3F1C053),
	helpstring("IEMSAlertManagerGtwy3 Interface"),
	pointer_default(unique)
]
interface IEMSAlertManagerGtwy3 : IEMSAlertManagerGtwy2
{
	// Same as SendSolution() but the input is EMSABLData
	HRESULT SendSolutionEx(	[in] const unsigned long culDestID, // identifies the LUT where this request is to be processed
							[in] const EMSGATEWAYTOKEN* cpsecToken,
							[in] const EMSTRIGGER ceTrigger,
							[in] const unsigned long culSolutionDestination,
							[in] const unsigned long culSatID,
							[in] const unsigned long culPassID,
							[in] const EMSABLData* cpABLData,
							[in] const char cszUserID[ EMS_MAX_USER_NAME ],
							[in] const BOOL cbSendNow );
};


