interface IEMSSatelliteInfo4 : IEMSSatelliteInfo3
{

	typedef struct _tagEMSSATCONFIGBOOLDATAPROPEX
	{
		BOOL 				bSpectrum;
		BOOL 				bAudio;
		BOOL 				bSarr;
		BOOL 				bSarp;
		BOOL 				bCbc121;
		BOOL 				bCbc243;
		BOOL 				bCbc406;
		BOOL 				bMI406;
		BOOL 				bLeoGeo;
		BOOL 				bLeoLeo;
		BOOL 				bGeoGeo;
		BOOL 				bReserved;
//		BOOL 				bInvalidProtocol;
	}	EMSSATCONFIGBOOLDATAPROPEX, *LPEMSSATCONFIGBOOLDATAPROPEX;

	typedef struct _tagEMSSATCONFIGMCCSUPPRESSEX
	{
		EMSSATCONFIGBOOLDATAPROPEX	Located;	 
		EMSSATCONFIGBOOLDATAPROPEX	UnLocated;	 
		EMSSATCONFIGBOOLDATAPROPEX	UnLocated1;	 
