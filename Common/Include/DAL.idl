typedef enum tagEMSDBFieldType
{
	DBFLDTYPE_UNKNOWN = 0,
	DBFLDTYPE_SHORT = 1,
	DBFLDTYPE_USHORT = 2,
	DBFLDTYPE_LONG = 3,
	DBFLDTYPE_ULONG = 4,
	DBFLDTYPE_BIGINT = 5,
	DBFLDTYPE_UBIGINT = 6,
	DBFLDTYPE_WSTRING = 7,
	DBFLDTYPE_STRING = 8,
	DBFLDTYPE_BINARY = 9,
	DBFLDTYPE_LONG_BINARY = 10,
	DBFLDTYPE_FLOAT = 11,
	DBFLDTYPE_DOUBLE = 12,
	DBFLDTYPE_TINYINT = 13,
	DBFLDTYPE_UTINYINT = 14,
	DBFLDTYPE_BOOLEAN = 15,
	DBFLDTYPE_DATETIME = 16,
	DBFLDTYPE_VARCHAR = 17,
	DBFLDTYPE_CHAR = 18,
	DBFLDTYPE_LAST
} EMSDBFLDTYPE;

typedef long EMSDALCACHEID;
const EMSDALCACHEID INITIALDALCACHEID = 0;
const EMSDALCACHEID NULLDALCACHEID = 0;
const EMSDALCACHEID DONTCACHE = -1;

// Remove once code that uses this type has been updated.
typedef struct tagEMSRetrievalProperties
{
	unsigned long ulCacheID;
	unsigned long ulMaxRecords;
	unsigned long ulTotalRecords;
	boolean bReturnDescriptor;
	unsigned long ulRecordSize;
} EMSRETRIEVALPROPS;

#define MAX_FIELD_NAME 64
cpp_quote("#define MAX_FIELD_NAME 64")

typedef struct tagEMSFieldDescriptor
{
	EMSDBFLDTYPE eType;
	long lSize;
	wchar_t wszName[MAX_FIELD_NAME + 1 ];
} EMSFIELDDESCRIPTOR;

//! @enum eEMSRecordType
//! The valid record types.
typedef enum eEMSRecordType
{
	EMSRT_UNKNOWN = 0,
	EMSRT_ANTENNA = 1,
	EMSRT_CALIB406 = 2,
	EMSRT_CALIBCBC = 3,
	EMSRT_CALIBCBC_STATS = 4,
	EMSRT_CBC = 5,
	EMSRT_COLLECTOR = 6,
	EMSRT_COMB406 = 7,
	EMSRT_COMB406_STATS = 8,
	EMSRT_COMMS_STATS = 9,
	EMSRT_CONFIG = 10,
	EMSRT_GEO_CALIB406_STATS = 11,
	EMSRT_GEO_STATS = 12,
	EMSRT_LEO_CALIB406_STATS = 13,
	EMSRT_LOCATE = 14,
	EMSRT_LOCATE_STATS = 15,
	EMSRT_LOG = 16,
	EMSRT_ORBIT = 17,
	EMSRT_ORBIT_STATS = 18,
	EMSRT_PASS_STATS = 19,
	EMSRT_RESIDUAL = 20,
	EMSRT_SARP_CALIB = 21,
	EMSRT_SARP_CALIB_STATS = 22,
	EMSRT_SARP = 23,
	EMSRT_SARR_CALIB = 24,
	EMSRT_SARR_CALIB_STATS = 25,
	EMSRT_SARR = 26,
	EMSRT_SAT_TRACK = 27,
	EMSRT_SENSOR = 28,
	EMSRT_SPECTRUM = 29,
	EMSRT_STAT_SUMMARY = 30,
	EMSRT_WIDEBAND_STATS = 31,
	EMSRT_AUDIO = 32,
	EMSRT_MANOEUVRE = 33,
	EMSRT_SARP_CALIB_124 = 34,			// Backwards compatibility to LEO 1.2.4 DB version
	EMSRT_SARP_CALIB_STATS_124 = 35,	// Backwards compatibility to LEO 1.2.4 DB version
	EMSRT_SARR_124 = 36,				// Backwards compatibility to LEO 1.2.4 DB version
	EMSRT_LOCATE_124 = 37,				// Backwards compatibility to LEO 1.2.4 DB version
	EMSRT_SARR_EXT = 38,
	EMSRT_CALIB406_EXT = 39,
	EMSRT_CALIB406_2 = 40,
	EMSRT_LUT_STATUS = 41,
	EMSRT_ABL_DATA = 42,
	EMSRT_HEALTH_STATUS = 43,
	EMSRT_HEALTH_DETECTIONS = 44,
	EMSRT_BEACON_ADVISORY = 45,
	EMSRT_LP_STATUS = 46,
	EMSRT_LAST = EMSRT_LP_STATUS
} EMSRECORDTYPE;




typedef struct tagEMSVariantRecord
{
	EMSRECORDTYPE eType;
	
	[switch_type(EMSRECORDTYPE), switch_is((EMSRECORDTYPE)eType)]
	union
	{
		[ case( EMSRT_ANTENNA,  
				EMSRT_CALIBCBC_STATS,
				EMSRT_COLLECTOR,
				EMSRT_COMB406_STATS,
				EMSRT_COMMS_STATS,
				EMSRT_GEO_CALIB406_STATS,
				EMSRT_GEO_STATS,
				EMSRT_LEO_CALIB406_STATS,
				EMSRT_LOCATE_STATS,
				EMSRT_ORBIT_STATS,
				EMSRT_PASS_STATS,
				EMSRT_SARR_CALIB_STATS,
				EMSRT_SARP_CALIB_STATS,
				EMSRT_SARP_CALIB_STATS_124,
				EMSRT_SENSOR,
				EMSRT_WIDEBAND_STATS,
				EMSRT_LUT_STATUS ) ]
			EMSLEOSTATUSUPDATE 	status;
		[ case( EMSRT_CALIB406 ) ]
			EMSCALIB406DATA calib406;
		[ case( EMSRT_CALIBCBC ) ]
			EMSCBCOUTPUTDATA calibCBC;
		[ case( EMSRT_CBC ) ]
			EMSCBCDATA rawCBC;
		[ case( EMSRT_COMB406 ) ]
			EMSCOMBINE406DATA combine406;
		[ case( EMSRT_CONFIG ) ]
			EMSCONFIGPACKET config;
		[ case( EMSRT_LOCATE, EMSRT_LOCATE_124 ) ]
			EMSLOCATE locate;
		[ case( EMSRT_LOG ) ]
			EMSLOGDATA log;
		[ case( EMSRT_ORBIT ) ]
			EMSTLERECORD tle;
		[ case( EMSRT_RESIDUAL ) ]
			EMSRESIDUALDATA residual;
		[ case( EMSRT_SARP_CALIB, EMSRT_SARP_CALIB_124 ) ]
			EMSSARPCALIBDATA sarpcalib;
		[ case( EMSRT_SARP ) ]
			EMSSARPDATA sarp;
		[ case( EMSRT_SARR_CALIB ) ]
			EMSSARRCALIBDATA sarrcalib;
		[ case( EMSRT_SARR, EMSRT_SARR_124 ) ]
			EMSSARRDATA sarr;
		[ case( EMSRT_SAT_TRACK ) ]
			EMSSATTRACKRECORD satTrack;
		[ case( EMSRT_SPECTRUM ) ]
			EMSSPECTRUM spectrum;
		[ case( EMSRT_MANOEUVRE ) ]
			EMSMANOEUVREDATA manoeuvre;
		[ case( EMSRT_AUDIO ) ]
			EMSAUDIODATARECORD_RIFF audio;
		[ case( EMSRT_STAT_SUMMARY ) ]
			EMSALARMDATA statsummary;
		[ default ]
			;
	} data;
} EMSVARIANTRECORD;

typedef struct tagEMSVariantRecord2
{
	EMSRECORDTYPE eType;
	
	[switch_type(EMSRECORDTYPE), switch_is((EMSRECORDTYPE)eType)]
	union
	{
		[ case( EMSRT_ANTENNA,  
