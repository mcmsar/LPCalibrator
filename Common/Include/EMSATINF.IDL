]
interface IEMSSatelliteInfo6 : IEMSSatelliteInfo5
{
	typedef struct _tagEMSCALIBCBCCONFIGDATA
	{
		BYTE    bAmplitudeMinimum;     //      (0)
		double  dTimeResolution;       // Secs (3.0)
		double  dFrequencyResolution;  // Hz   (100.0)
		double  dFrequencyBandwidth;   // Hz   (400.0)
		double  dCorrelationThreshold; //        (20184002)
		long    lTemplateNumber;       //        (64)
		double  dTemplateDuration;     // Secs (600.0)
	} EMSCALIBCBCCONFIGDATA, *LPEMSCALIBCBCCONFIGDATA;

	typedef struct _tagEMSTCALCONFIGDATA
	{
		double  dUpdatePeriod;         // Days  (0.5)
		double  dDuration;             // Days  (10.0)
		long    lMinPts;               //       (200)
		double  dTimeThreshold;        // Secs  (0.100)
		double  dFrequencyThreshold;   // Hz    (0.100)
	} EMSTCALCONFIGDATA, *LPEMSTCALCONFIGDATA;

	typedef struct _tagEMSMI406CONFIGDATA
	{
		BOOL    bRestart;
		double  dWindowFreq;
		double  dWindowTime;
		DWORD   dwWindowBits;
		INT		nOutOfSpecWindowBits;
		double	dMsgTimeoutMinutes;
		BOOL	bMsgForceUpdate;
		DWORD   dwFSErrMax;
		DWORD   dwPF1ErrMax;
		DWORD   dwPF2ErrMax;
		DWORD   dwAgeout;
		double  dCNR1Threshold;
		double  dCNR2Threshold;
		double	dSarrFreqOffsetThreshold;	
		double	dSummaryInterval;
	} EMSMI406CONFIGDATA, *LPEMSMI406CONFIGDATA;

	typedef struct _tagEMSCALIB406CONFIGDATA
	{
		EMSTIME	timeLastMsg;			// Time of last message processed
		double	dRealTimeDelaySecs;	// Real-time satellite relay delay
		double	dSarrSarpHistoryAgeoutDays;	// Days to keep SarrSarp history
		double	dSarrSarpFreqDiffHz; // Acceptable Freq Diff between Sarr-Sarp
		double	dSarrSarpTimeDiffSecs; // Acceptable Time Diff
		INT		nSarrSarpMinCount;		//
		BOOL	bSarrSarpCombine;			// Merge same Sarr Sarp pairs
	} EMSCALIB406CONFIGDATA, *LPEMSCALIB406CONFIGDATA;

	typedef struct _tagEMSORBITDETCONFIGDATA
    {
		double  dPositionThreshold;
		double  dVelocityThreshold;
		double  dDurationMaximum;
		int     iIterationMinimum;
		int     iIterationMaximum;
		double  dResidualMinimum;
		double  dResidualMaximum;
		BOOL    bDownlink;
		ULONG   ulBeaconMinPts;
    } EMSORBITDETCONFIGDATA, *LPEMSORBITDETCONFIGDATA;

	typedef struct _tagEMSLOCATECBCCONFIGDATA
    {
		ULONG   ulDetectMinimum;
		BYTE    cAmplitudeRangeMin;
		BYTE    cAmplitudeRangeMax;
		ULONG   ulIterationsMaximum;
		double  dThreshold;
		double  dCorrelationMaximum;
		BOOL    bDrift;
		double  dEEScaleFactors[3];
		double  dEEAdjustments[3];
		double  dSweepThreshold;
		ULONG   ulSweepMinPoints;
    } EMSLOCATECBCCONFIGDATA, *LPEMSLOCATECBCCONFIGDATA;

	typedef struct _tagEMSLOCATE406CONFIGDATA
    {
		ULONG   ulIterationsMaximum;
		double  dThreshold;
		double  dCorrelationMaximum;
		BOOL    bDrift;
		BOOL    bAltitude;
		double  dEEScaleFactors[3];
		double  dEEAdjustments[3];
    } EMSLOCATE406CONFIGDATA, *LPEMSLOCATE406CONFIGDATA;

	HRESULT GetCalibCbcConfigData( [in] ULONG ulSatelliteID, [out] LPEMSCALIBCBCCONFIGDATA lpCalibCbcConfigData );
	HRESULT GetTcalConfigData( [in] ULONG ulSatelliteID, [out] LPEMSTCALCONFIGDATA lpTcalConfigData ); 
	HRESULT GetMI406ConfigData( [in] ULONG ulSatID, [out] LPEMSMI406CONFIGDATA lpMI406ConfigData ); 
	HRESULT GetCalib406ConfigData( [in] ULONG ulSatID, [out] LPEMSCALIB406CONFIGDATA lpCalib406ConfigData ); 
	HRESULT	GetOrbitDetConfigData( [in] ULONG ulSatID, [out] LPEMSORBITDETCONFIGDATA lpOrbitDetConfigData );
	HRESULT GetLocateCBCConfigData( [in] ULONG ulSatID, [out] LPEMSLOCATECBCCONFIGDATA lpLocateCbcConfigData );
	HRESULT GetLocate406ConfigData( [in] ULONG ulSatID, [out] LPEMSLOCATE406CONFIGDATA lpLocate406ConfigData );

};

