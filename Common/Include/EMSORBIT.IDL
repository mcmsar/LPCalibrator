cpp_quote("// Flags for SetSatelliteTLE3 ")
cpp_quote("#define EMS_ORBIT_OVERRIDE_MORE_RECENT	(0x0001)")
cpp_quote("#define EMS_ORBIT_OVERRIDE_ALL			(0x0002)")
