interface IEMSSatelliteInfo3 : IEMSSatelliteInfo2
{
	#define EMSSATCONFIGAUDIO_MAX_BANDS (5)

	typedef struct _tagEMSSATCONFIGBOOLDATAPROP
	{
		BOOL 				bSpectrum;
		BOOL 				bAudio;
		BOOL 				bSarr;
		BOOL 				bSarp;
		BOOL 				bCbc121;
		BOOL 				bCbc243;
		BOOL 				bCbc406;
		BOOL 				bMI406;
		BOOL 				bLeoGeo;
		BOOL 				bLeoLeo;
		BOOL 				bGeoGeo;
	}	EMSSATCONFIGBOOLDATAPROP, *LPEMSSATCONFIGBOOLDATAPROP;

	typedef struct _tagEMSSATCONFIGDOUBLEDATAPROP
	{
		DOUBLE 				dSpectrum;
		DOUBLE 				dAudio;
		DOUBLE 				dSarr;
		DOUBLE 				dSarp;
		DOUBLE 				dCbc121;
		DOUBLE 				dCbc243;
		DOUBLE 				dCbc406;
		DOUBLE 				dMI406;
		DOUBLE 				dLeoGeo;
		DOUBLE 				dLeoLeo;
		DOUBLE 				dGeoGeo;
	}	EMSSATCONFIGDOUBLEDATAPROP, *LPEMSSATCONFIGDOUBLEDATAPROP;

	typedef struct _tagEMSSATCONFIGINTDATAPROP
	{
		INT 				nSpectrum;
		INT 				nAudio;
		INT 				nSarr;
		INT 				nSarp;
		INT 				nCbc121;
		INT 				nCbc243;
		INT 				nCbc406;
		INT 				nMI406;
		INT 				nLeoGeo;
		INT 				nLeoLeo;
		INT 				nGeoGeo;
	}	EMSSATCONFIGINTDATAPROP, *LPEMSSATCONFIGINTDATAPROP;

	typedef struct _tagEMSSATCONFIGMCCFILTERLEOGEO
	{
		int				nWindowFactor;
		int				nNumPts;
		double			dMinCrossTrackAngle;
		double			dMaxCrossTrackAngle;
	} EMSSATCONFIGMCCFILTERLEOGEO, *LPEMSSATCONFIGMCCFILTERLEOGEO;

	typedef struct _tagEMSSATCONFIGMCCSUPPRESS
	{
		EMSSATCONFIGBOOLDATAPROP	Located;	 
		EMSSATCONFIGBOOLDATAPROP	UnLocated;	 
		EMSSATCONFIGBOOLDATAPROP	UnLocated1;	 
		EMSSATCONFIGBOOLDATAPROP	UnLocated2;	 
		EMSSATCONFIGMCCFILTERLEOGEO LeoGeo;
	} EMSSATCONFIGMCCSUPPRESS, *LPEMSSATCONFIGMCCSUPPRESS;

	typedef struct _tagEMSSATCONFIGPROCESS
	{
		EMSSATCONFIGBOOLDATAPROP	Normal;
		EMSSATCONFIGBOOLDATAPROP	MultiPass;	
		EMSSATCONFIGBOOLDATAPROP	MultiSat;	
	} EMSSATCONFIGPROCESS, *LPEMSSATCONFIGPROCESS;

	typedef struct _tagEMSSATCONFIGAUDIO
	{
		double			dFileDuration;			// max mins in a single file
		double			dArchiveDuration;	      	// max age of archive
		ULONG 			ulFileSize;		 	// max number of bytes in a single file
		ULONG 			ulArchiveSize;	  		// max number of bytes in archive of files
		int		      	nBands;
		struct	
		{
			double		dMinFreq;
			double		dMaxFreq;
		} band[ EMSSATCONFIGAUDIO_MAX_BANDS ];
	} EMSSATCONFIGAUDIO, *LPEMSSATCONFIGAUDIO;

	typedef struct _tagEMSSATCONFIGTCAL
	{
		int				nMinPts;
		double			dThresholdTime;
		double			dThresholdFrequency;
	} EMSSATCONFIGTCAL, *LPEMSSATCONFIGTCAL;

	typedef struct _tagEMSSATCONFIGORBIT
	{
		double			dThresholdPosition;
		double			dThresholdVelocity;
		int				nMinPtsDownlink;
		int				nMinPtsBeacon;
		EMSTIME			refTime;
	} EMSSATCONFIGORBIT, *LPEMSSATCONFIGORBIT;

	HRESULT GetMCCSuppressInfo( [in] ULONG ulSatelliteID, [out] EMSSATCONFIGMCCSUPPRESS *lpMCCSUPPRESSInfo );

	HRESULT GetTCALInfo( [in] ULONG ulSatelliteID, [out] EMSSATCONFIGTCAL *lpTCALInfo );

	HRESULT GetOrbitInfo( [in] ULONG ulSatelliteID, [out] EMSSATCONFIGORBIT *lpOrbitInfo );

	HRESULT GetAudioInfo( [in] ULONG ulSatelliteID, [out] EMSSATCONFIGAUDIO *lpAudioInfo );

	HRESULT GetProcessInfo( [in] ULONG ulSatelliteID, [out] EMSSATCONFIGPROCESS *lpProcessInfo );

	HRESULT GetCollectInfo( [in] ULONG ulSatelliteID, [out] EMSSATCONFIGBOOLDATAPROP *lpCollectInfo );

	HRESULT GetPassSchedulePriority( [in] ULONG ulSatelliteID, [out] ULONG *lpulPriority );

	HRESULT SetSarpCalibration( [in] ULONG ulSatelliteID, [in] EMSTIME timeRollover, [in] double dRefFreq );

	HRESULT GetSarpCalibration( [in] ULONG ulSatelliteID, [out] EMSTIME *lpTimeStamp, [out] EMSTIME *lpTimeRollover, [out] double * lpdRefFreq );

	HRESULT GetDownlinkFreq( [in] ULONG ulSatelliteID, [out] double *lpdDownlinkFreq );
};

typedef [unique] IEMSSatelliteInfo3 *LPEMSSATELLITEINFO3;


