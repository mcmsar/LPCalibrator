interface IEMSDataSource : IUnknown
{
	typedef [unique] IEMSDataSource *LPEMSDATASOURCE;

	HRESULT SetType( [in] BYTE cDataType );
	HRESULT GetType( [out] BYTE *lpcDataType );
	HRESULT GetMaxLength( [out] INT *lpnMaxLength );
	HRESULT SetMaxLength( [in] INT nMaxLength );
	HRESULT SetStream( [in] LPEMSPACKETSTREAM lpStream );
	HRESULT GetStream( [out] LPEMSPACKETSTREAM *lplpStream );
};

[
	object, uuid(488E3137-7AD3-11d5-8BFD-009027912866),
	pointer_default(unique)
]

interface IEMSDataSink : IUnknown
{
	typedef [unique] IEMSDataSink *LPEMSDATASINK;

	HRESULT SetType( [in] BYTE cDataType );
	HRESULT GetType( [out] BYTE *lpcDataType );
	HRESULT SetMaxLength( [in] INT nMaxLength );
	HRESULT GetMaxLength( [out] INT *lpnMaxLength );
	HRESULT SetStream( [in] LPEMSPACKETSTREAM lpStream );
	HRESULT GetStream( [out] LPEMSPACKETSTREAM *lplpStream );
	HRESULT OnDataAvailable( [in] DWORD dwSize, [in] DWORD dwFlags );
};

