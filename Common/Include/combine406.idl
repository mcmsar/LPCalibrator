cpp_quote("#ifndef INC_COMBINE406")
cpp_quote("#define INC_COMBINE406")
cpp_quote("")
cpp_quote("#include \"calib406.h\"	")

import "unknwn.idl";
import "emstypex.idl";
import "calib406.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

const unsigned long EMSCOMBINE406VERSION = 1;

[
	uuid(4A82F7C9-0E7E-4f34-B838-0867CF98FC1C),
	helpstring("IEMSCOMBINE406data"),
	pointer_default(unique)
]

interface IEMSCOMBINE406data
{
#pragma pack(1)

typedef enum _tagEMSCOMBINE406TYPE
    {
    	EMSCOMBINETYPE_406_FDOA	 	= 0x41,
		EMSCOMBINETYPE_406_TDOA	 	= 0x42,
		EMSCOMBINETYPE_406_FDOA_TDOA	= 0x43
    }	EMSCOMBINE406TYPE;

typedef struct _tagEMSCOMBINE406DATA
{
	EMSSIGDATAIDTYPE	hdr;
	EMSCALIB406DATA 	dataA;
	EMSCALIB406DATA 	dataB;
	} EMSCOMBINE406DATA, *LPEMSCOMBINE406DATA;

#pragma pack()
}

