cpp_quote("#ifndef INC_SARRDATA")
cpp_quote("#define INC_SARRDATA")
cpp_quote("")

#define EMSSARRMSGLENGTH	(18)			// 144 bits

cpp_quote("#define EMSSARRMSGLENGTH	(18)			// 144 bits")

import "unknwn.idl";
import "emstypex.idl";
import "sigdata.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(E3681A64-EAB0-11d5-8D22-009027912866),
	helpstring("IEMSSARRdata"),
	pointer_default(unique)
]


interface IEMSSARRdata
{
#pragma pack(1)

typedef struct _tagEMSSARRDATA
{
	EMSSIGDATAIDTYPE	hdr;					// time, ulSatID, ulLutID, wType
	ULONG			ulPassID;
	EMSTIME		timeMsg;
	INT64			i64TimeOffset;
	INT64			i64BeaconID;				// Beacon ID
	BYTE			cBeaconMsg[ EMSSARRMSGLENGTH ];	// Full 144 bit pattern
	double		dFrequency;					// Frequency in Hz
	float			fFreqOffset;				// Frequency offset in Hz (satellite/ground station dependency)
	float			fFreqBandwidth; 			// Frequency bandwidth of carrier in Hz (dependent upon Doppler)
	float			fCarrierToNoiseRatio;	// Carrier to Noise Ratio (dB-Hz) or Power (dBm)
	float			fSignalToNoiseRatio;		// Signal to Noise Ratio (dB-Hz)
	WORD			wBitErrorField1;        // Number of bit errors in first protected field
	WORD			wBitErrorField2;        // Number of bit errors in second protected field
	WORD			wBitErrorFrameSynch;    // Number of bit errors in  frame synch
	float       fBitRate;           		// Bit Rate in bits/sec
	float			fModIndex;         		// Modulation Index in radians
	float			fShortMessIndex;   		// Average bit power ratio of long message bits to short message bits
	float			fFrameSyncMessIndex;		// Frame sync test to message power correlation ratio
  float			fFrameSyncBitOffset;		// Direction and number of bits between the test and message frame sync
	float			fRawBitPower[144];		// Raw bit power values (for message integration and diagnostics)
} EMSSARRDATA, *LPEMSSARRDATA;

#pragma pack()
}

cpp_quote("#endif // INC_SARRDATA")





