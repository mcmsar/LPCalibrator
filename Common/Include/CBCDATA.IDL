cpp_quote("#ifndef INC_CBCDATA")
cpp_quote("#define INC_CBCDATA")
cpp_quote("")

import "unknwn.idl";
import "emstypex.idl";
import "sigdata.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

#define EMSCBCBINCOUNT	(128)

cpp_quote("#define EMSCBCBINCOUNT	(128)")

[
	uuid(E3681A65-EAB0-11d5-8D22-009027912866),
	helpstring("IEMSCBCdata"),
	pointer_default(unique)
]

interface IEMSCBCdata
{
#pragma pack(1)

typedef enum _tagEMSCBCTYPE
{
	EMSCBCTYPE_121 = 121,
	EMSCBCTYPE_243 = 243,
	EMSCBCTYPE_406 = 406

}EMSCBCTYPE;

typedef struct _tagEMSCBCDATA
{
	EMSSIGDATAIDTYPE	hdr;				// time, ulSatID, ulLutID, wType
	ULONG			ulPassID;
	float			fFreqOffset;         // Frequency offset in Hz
	float			fFreqQFactor;        // Frequency quantization factor (nominally 3.125 Hz)
	float			fThreshold;          // Threshold used to establish amplitude 0 value (unitless)
	WORD			wEntryCount; 			// number of entries of wFrequency, cAmplitude, wSweep data
	WORD			wFrequency[ EMSCBCBINCOUNT ];     // Quantized Frequency  (Actual = Frequency*Dfreq+Offset)
	BYTE			cAmplitude[ EMSCBCBINCOUNT ];     // Amplitude in scaled 'CBC' counts above threshold (unitless)
	WORD			wSweepPeriod[ EMSCBCBINCOUNT ];	// sweep period ( 100th milliseconds )
	WORD 			wSweepCorrelation[ EMSCBCBINCOUNT ]; // power level units ( scaled )
	WORD			wSweepSpan[ EMSCBCBINCOUNT ];		// freq span of the ELT signal

} EMSCBCDATA, *LPEMSCBCDATA;

#pragma pack()
}

cpp_quote("#endif // INC_CBCDATA")



