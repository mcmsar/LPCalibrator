[
	uuid(0E9E42D7-DF41-4c4a-8F45-601B6DE3EA47),
	helpstring("IEMSSARRCALIBData Interface"),
	pointer_default(unique)
]

interface IEMSSARRCALIBData
{
#pragma pack(1)

	typedef struct _tagEMSSARRCALIBDATA
	{
		EMSSIGDATAID				hdr;					// time, ulSatID, ulLutID 
		ULONG							ulPassID;
		WORD							wSource;				
		EMSTIME						timeEffective;
		ULONG							ulSARRNumber;
		float							fFreqOffset;
		float							fFreqDrift;
		INT64							i64TimeOffset;
	} EMSSARRCALIBDATA, *LPEMSSARRCALIBDATA;

#pragma pack()
};

