cpp_quote("/* Flags */")
cpp_quote("#define EMS_PIPE_FIXED_LENGTH			(0x00000001)")
cpp_quote("#define EMS_PIPE_VARIABLE_LENGTH		(0x00000002)")
cpp_quote("#define EMS_PIPE_WAIT_WRITE			(0x00010000)")
cpp_quote("#define EMS_PIPE_SUB_SINKS				(0x01000000)")
cpp_quote("#define EMS_PIPE_IS_FULL				(0x02000000)")
cpp_quote("#define EMS_PIPE_DEFAULT_FLAGS		(0x10000000)")
cpp_quote("#define EMS_PIPE_DEFAULT_MAXLENGTH	(0x20000000)")
cpp_quote("#define EMS_PIPE_DEFAULT_MAXSINKS	(0x40000000)")
cpp_quote("#define EMS_PIPE_DEFAULT_MAXSOURCES	(0x80000000)")

cpp_quote("#define EMS_PIPE_COMMAND_CHANNEL	(0xFF)")
cpp_quote("#define EMS_PIPE_DEBUG_CHANNEL	(0xFE)")
cpp_quote("#define EMS_PIPE_MAX_COMMAND_LENGTH	(256)")

cpp_quote("")
cpp_quote("/* Info Flags */")
cpp_quote("#define EMS_PIPE_INFO_LOGGING_ON		(0x00000001)")

cpp_quote("")
cpp_quote("/* Command Connect Status Flags */")
cpp_quote("#define EMS_PIPE_STATUS_CONNECTED (0x80000000)")
cpp_quote("#define EMS_PIPE_STATUS_READY		 (0x00000001)")

[
	object, uuid(488E3138-7AD3-11d5-8BFD-009027912866),
	pointer_default(unique)
]

interface IEMSSeqStream : IUnknown
{
	typedef [unique] IEMSSeqStream *LPEMSSEQSTREAM;

	HRESULT Read(
		[out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
		[in] ULONG cb,
		[out] ULONG *pcbRead);

	HRESULT Write(
		[in, size_is(cb)] BYTE const *pv,
		[in] ULONG cb,
		[out] ULONG *pcbWritten);
};

[
	object, uuid(488E3139-7AD3-11d5-8BFD-009027912866),
	pointer_default(unique)
]

interface IEMSPacketStream : IEMSSeqStream
{
	typedef [unique] IEMSPacketStream *LPEMSPACKETSTREAM;

	HRESULT SetType( [in] BYTE cDataType );
	HRESULT GetType( [out] BYTE *lpcDataType );
	HRESULT SetMaxLength( [in] INT nMaxLength );
	HRESULT GetMaxLength( [out] INT *lpnMaxLength );
	HRESULT SetFlags( [in] DWORD dwFlags );
	HRESULT GetFlags( [out] DWORD *lpdwFlags );
};


[
	object, uuid(138E91E8-2D48-4190-9E63-FA19C90048C4),
	pointer_default(unique)
]
interface IEMSRandomStream : IEMSSeqStream
{
	typedef [unique] IEMSRandomStream* LPEMSRANDOMSTREAM;

	HRESULT MoveFirst();
	HRESULT MoveLast();
	HRESULT Move( [in] const long clIndex );
};

[
	object, uuid(7EC8F653-2B16-4cd2-8EFD-AD03B1FC250B),
	pointer_default(unique)
]
interface IEMSTextSeqStream : IEMSSeqStream
{
	typedef [unique] IEMSTextSeqStream *LPEMSTEXTSEQSTREAM;

	HRESULT ReadLine( [out, string] wchar_t** ppwszLine );
	HRESULT WriteLine( [in, string] wchar_t* pwszLine );
};


