import "unknwn.idl";
import "emstypex.idl";
import "emsicfg.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	object, uuid(F17394E2-4D52-11d5-8BB5-009027912866),
	helpstring("IEMSSatelliteInfo Interface"),
	pointer_default(unique)
]

interface IEMSSatelliteInfo : IEMSConfigSettings
{
	typedef enum _tagEMSSATELLITETYPE
	{
		EMSSatTypeLEOCospas = 0x0,
		EMSSatTypeLEOSarsat = 0x1,
		EMSSatTypeGEO = 0x2,
		EMSSatTypeMEO = 0x4,
		EMSSatTypeUNKNOWN = 0x8000
	} EMSSATELLITETYPE, *LPEMSSATELLITETYPE; 

	typedef struct _tagEMS406SIGNALDATA
	{
	  unsigned short  uProfile;            // Profile number
    EMSTIME			updateTime;               // Time of last update
//    unsigned short  uProcessFlag;        // Process flag (bits 0=GSARP,1=SARP,2=121,3=243,4=406,5=PSD, 6=Track,7=Audio)
    unsigned short  uReserved;       		 // was the process flag 
//    unsigned short  uMonitorFlag;        // Monitor flag (bits 0 - 8 are FR,C1,S1,C2,S2,C4,DI,MI,PD)
    unsigned short  uDelete1;        // Monitor flag (bits 0 - 8 are FR,C1,S1,C2,S2,C4,DI,MI,PD)
    float           fCentreFreq121;      // Centre frequency of baseband 121 channel (Hz)
    float           fCentreFreq243;      // Centre frequency of baseband 243 channel (Hz)
    float           fCentreFreq406;      // Centre frequency of baseband 406 channel (Hz)
    float           fBandwidth121;       // Frequency bandwidth of baseband 121 channel (Hz)
    float           fBandwidth243;       // Frequency bandwidth of baseband 243 channel (Hz)    float           Bandwidth406;       // Frequency bandwidth of baseband 406 channel (Hz)
    float           fBandwidth406;       // Frequency bandwidth of baseband 406 channel (Hz)
    float           fDetectThres;        // Detection threshold (multiplier of average power)
    float           fDetectThres406;     // 406 detection threshold (multiplier of average power)
    unsigned short  uMaxNumBPP;          // Maximum number of BPP detections per second
    float           fMinFreqBPP;         // Minimum frequency of BPP band (Hz)
    float           fMaxFreqBPP;         // Maximum frequency of BPP band (Hz)
    float           fDetectThresBPP;     // BPP detection threshold (multiplier of average power)
    float           fMinCNRBPP;          // BPP minimum CNR level output (dB-Hz)
    unsigned short  uMaxFSerrBPP;        // Maximum number of BPP frame synch bit errors allowed
    unsigned short  uModeMI;             // Message integration mode of operation
    unsigned short  uRestartMI;          // Message Integration restart after each valid output (on/off flag)
    float           fAgeoutMI;           // Message integration ageout time  (minutes)
    float           fPartialAgeoutMI;    // Message integration partial ageout time  (minutes)
    float           fWindFreqMI;         // Frequency bandwidth for beacon message match (Hz)
    float           fWindTimeMI;         // Time duration window for beacon message match (seconds)
    unsigned short  uWindBitMI;          // Maximum number of bit differences for beacon message match
    unsigned short  uMaxFSerrMI;         // Maximum number of frame synch errors (output threshold)
    unsigned short  uMaxPF1MI;           // Maximum number of 1st protected field errors (output threshold)
    unsigned short  uMaxPF2MI;           // Maximum number of 2nd protected field errors (output threshold)
    float           fMinCNRMI;           // Message integration minimum CNR level output (dB-Hz)
    float           fMinCNRPF2MI;        // Message integration minimum CNR level for 2nd P.F. output (dB-Hz)
    unsigned short  uShortMsgFillMI;     // Short Message zero fill (on/off flag)
    float           fBitRatePDS;         // PDS bit rate (bits per second)
    unsigned short  uSARPtypePDS;        // SARP type (0,1,2)
    unsigned short  uPlaybackPDS;        // PDS dump data enabled for output
    long            lNfloorDet0;         //
	long            lNfloorDet1;         //
	long            lDetTestMsg;         //
	float           fOnDet406;           //
	float           fOffDet406;          //
	float           fCoeffDet;           //
	unsigned short  uDetTestMsgMI;       //
	unsigned short  uNumPartialOutMI;    //
	float           fTimePartialOutMI;   //
	float           fFreqOffset406;      //
  double 				dSarrPowerConstant;
	}	EMS406SIGNALDATA, *LPEMS406SIGNALDATA;

	typedef struct _tagEMSCBCSIGNALDATA
	{
    int             nfloor0;
    int             nfloor1;
    int             nsmooth0;
    int             nsmooth1;
    float           fpkfak[3];
    float           fAmp[3];
    float           fIncoherentOffset;
	float           fDetectThres;
	float           fMinFreq[3];
	float           fMaxFreq[3];
	float           fDetFreq;
    unsigned short  uDataC1;
    unsigned short  uDataC2;
    unsigned short  uDataC4;
	}	EMSCBCSIGNALDATA, *LPEMSCBCSIGNALDATA;

// note to self:  Look at wideband code to confirm Rollover calcs, etc

	typedef struct _tagEMSPDSSIGNALDATA
	{
//	char  cRolloverTime[25];
	char  cReserved1[25];
  EMSTIME		timeUpdate;               // Time of last update
	double		dReserved2;					// was dRefFreq
	INT64			i64RolloverPeriod;
	EMSTIME		timeRollover;
	float fReserved3;							// was fRefFreqOffset
   float                       fBaudRate;
   float                       fBaudWindow;
   float                       fBaudStep;
   unsigned short				uBaudDuration;
   float                       fBaudStart;
   float                       fBaudStop;
   unsigned short            uBaudElapsed;
	unsigned	short						uSarpSatellite;
	unsigned	short						uSarpProcessor;
	unsigned	short						uSarpPlayback;
   unsigned short              uSarpType;
   unsigned short              uPlaybackPDS;
   unsigned short              uDataPD;
   unsigned short              uDataRP;
   unsigned short              uDataTI;
   unsigned short              uDataRPO;
                               // Control the output of raw_pds_msg
                               // DataRPO = 0: Not output; =1: Output
	}	EMSPDSSIGNALDATA, *LPEMSPDSSIGNALDATA;

	HRESULT GetName( [in] ULONG ulSatelliteID,
		[out, size_is(cb), length_is(*pcbRead)]	BYTE *pv,
		[in] ULONG cb,
		[out] ULONG *pcbRead);

	HRESULT GetNoradID( [in] ULONG ulSatelliteID, [out] ULONG *lpulNoradID );
	HRESULT GetSatelliteID( [in] ULONG ulNoradID, [out] ULONG *lpulSatelliteID );
	HRESULT GetFreqBandwidth( [in] ULONG ulSatelliteID, [out] LONG *lplBandwidth );
	HRESULT GetCaps( [in] ULONG ulSatelliteID, [out] ULONG *lpulCapabilities );
	HRESULT Get406SignalData( [in] ULONG ulSatelliteID, [out] EMS406SIGNALDATA *lpSignalData);
	HRESULT GetCBCSignalData( [in] ULONG ulSatelliteID, [out] EMSCBCSIGNALDATA *lpSignalData);
	HRESULT GetPDSSignalData( [in] ULONG ulSatelliteID, [out] EMSPDSSIGNALDATA *lpSignalData);

	HRESULT GetRolloverPeriod( [in] ULONG ulSatelliteID, [out] INT64 *lpi64Period );
	HRESULT SetRolloverPeriod( [in] ULONG ulSatelliteID, [in] INT64 i64Period );
	HRESULT GetRolloverTime( [in] ULONG ulSatelliteID, [out] EMSTIME *lpTimeRollover );
	HRESULT SetRolloverTime( [in] ULONG ulSatelliteID, [in] EMSTIME timeRollover );
	HRESULT GetRefFreq( [in] ULONG ulSatelliteID, [out] double *lpdFreq );
	HRESULT SetRefFreq( [in] ULONG ulSatelliteID, [in] double dFreq );

	HRESULT SetSarrFreqOffset( [in] ULONG ulSatelliteID, [in] double dFreqOffset );
	HRESULT GetSarrFreqOffset( [in] ULONG ulSatelliteID, [out] double *lpdFreqOffset );
	HRESULT SetSarrTimeOffset( [in] ULONG ulSatelliteID, [in] INT64 i64TimeOffset ) ;
	HRESULT GetSarrTimeOffset( [in] ULONG ulSatelliteID, [out] INT64 *lpi64TimeOffset );
	HRESULT SetSarpFreqOffset( [in] ULONG ulSatelliteID, [in] double dFreqOffset );
	HRESULT GetSarpFreqOffset( [in] ULONG ulSatelliteID, [out] double *lpdFreqOffset );
	HRESULT SetSarpTimeOffset( [in] ULONG ulSatelliteID, [in] INT64 i64TimeOffset ) ;
	HRESULT GetSarpTimeOffset( [in] ULONG ulSatelliteID, [out] INT64 *lpi64TimeOffset );

};

typedef [unique] IEMSSatelliteInfo *LPEMSSATELLITEINFO;

