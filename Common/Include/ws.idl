cpp_quote("// {45C2DC62-1097-4bbf-8915-97CEFAA2B987}")
cpp_quote("DEFINE_GUID( IID_IEMSWS, 0x45c2dc62, 0x1097, 0x4bbf, 0x89, 0x15, 0x97, 0xce, 0xfa, 0xa2, 0xb9, 0x87);")

import "unknwn.idl";

[
	uuid(45C2DC62-1097-4bbf-8915-97CEFAA2B987),
	helpstring("IEMSWS"),
	pointer_default(unique)
]
interface IEMSWS : IUnknown
{
	HRESULT SetConfig( [in,string] const wchar_t* cwszConfig );

	HRESULT SetHost( [in,string] const wchar_t* cwszHost );

	HRESULT SetPort( [in] const int ciPort );

	HRESULT SetBacklog( [in] const int ciBacklog );

	HRESULT EnableAuthenticate( [in] const BOOL cbEnabled );

	HRESULT SetNumHandlers( [in] const int ciHandlers );

	HRESULT Start();

	HRESULT Stop();

	HRESULT IsRunning( [out] BOOL* pbIsRunning );

}
