cpp_quote("#ifndef INC_SIGDATA")
cpp_quote("#define INC_SIGDATA")
cpp_quote("")
cpp_quote("#include \"emstypes.h\"")

import "unknwn.idl";
import "emstypex.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(CD360654-E910-11d5-8D1E-009027912866),
	helpstring("IEMSSIGDATAdata"),
	pointer_default(unique)
]

interface IEMSSIGDATAdata
{

#pragma pack(1)

	typedef struct _tagEMSSIGDATAID
	{
		EMSTIME		time;               // time
		ULONG			ulSatID;       	  // Satellite Identifier number (according to COSPAS-SARSAT)
		ULONG			ulLutID;				 	// Lut Identifier
	} EMSSIGDATAID, *LPEMSSIGDATAID;

	typedef struct _tagEMSSIGDATAIDTYPE
	{
		EMSSIGDATAID	id;
		WORD				wType;				// type spec. ( different meaning dep. )
	} EMSSIGDATAIDTYPE, *LPEMSSIGDATAIDTYPE;

#pragma pack()
}

cpp_quote("#endif // INC_SIGDATA")


