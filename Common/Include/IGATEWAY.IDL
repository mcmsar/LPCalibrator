cpp_quote( "#define ORIG_DEST_SIZE 64" )
#define ORIG_DEST_SIZE 64

typedef enum tagEMSGATEWAYDATATYPE
{
	EMSGatewayDataUnknown = 0,
	EMSGatewayPtrFlag = 0x8000,
	EMSGatewaySitMsg = 1,							// Buffer containing serialized SIT message
	EMSGatewaySITMsgFile = 2,						// Path/Filename of SIT message file.
	EMSGatewaySITPtr = 3,							// Pointer to a SIT message object.
	EMSGatewaySitMsgPtr = 1 + EMSGatewayPtrFlag		// Pointer to a SIT message class.
} EMSGATEWAYDATATYPE, *LPEMSGATEWAYDATATYPE;

#pragma pack(1)


typedef enum tagEMSGATEWAYADDRESSTYPE
{
	EMSGatewayCSAddress	= 1,			// COSPAS-SARSAT name
	EMSGatewayIPAddress	= 2			// IP address [0].[1].[2].[3] binary
} EMSGATEWAYADDRESSTYPE, *LPEMSGATEWAYADDRESSTYPE;

cpp_quote( " " )
cpp_quote( "// Although cAddress is declared as a byte array it ALWAYS ")
cpp_quote( "// holds a char* representation of the address." )
cpp_quote( "// e.g. sprintf( (char*)lpTo->cAddress, \"%u\", ulLutID );" )
cpp_quote( " " )

typedef struct tagEMSGATEWAYADDRESS
{
	EMSGATEWAYADDRESSTYPE type;		
	BYTE cAddress[ ORIG_DEST_SIZE ];
} EMSGATEWAYADDRESS, *LPEMSGATEWAYADDRESS;

[
	uuid(E4EAC144-030C-11d7-9D3F-000021FAA228),
	helpstring("IEMSGatewayConnection"),
	pointer_default(unique)
]

interface IEMSGatewayConnection : IUnknown
{
	HRESULT Connect( EMSGATEWAYADDRESS *lpFromAddress, DWORD dwFlags );

	HRESULT Disconnect( );

	HRESULT Send( [in] EMSGATEWAYDATATYPE eType,
				[in,size_is(lMsgSize)] BYTE cMsg[],
				[in] long lMsgSize,
				[in] EMSGATEWAYTOKEN *lpSecurityToken,
				[in] EMSGATEWAYADDRESS *lpToAddress );
};

// Interface implemented by clients to receive notification of the receipt of
// a message.
[
	uuid(E4EAC145-030C-11d7-9D3F-000021FAA228),
	helpstring("IEMSGatewayNotification"),
	pointer_default(unique)
]

interface IEMSGatewayNotification : IUnknown
{
	// Safe for out-of-proc/remote notifications.
	HRESULT OnMsgReceived( [in] EMSGATEWAYDATATYPE eType,
						   [in,size_is(lMsgSize)] BYTE cMsg[],
						   [in] long lMsgSize,
							[in] EMSGATEWAYTOKEN *lpSecurityToken,
						   [in] EMSGATEWAYADDRESS *lpFromAddress );
};

// Interface used by clients to register for notifications when messages
// are received.
[
	uuid(E4EAC146-030C-11d7-9D3F-000021FAA228),
	helpstring("IEMSGatewayEventManager"),
	pointer_default(unique)
]

interface IEMSGatewayEventManager : IUnknown
{
	HRESULT Advise(	[in] IEMSGatewayNotification* pNotify,		// Interface to be called with notifications.
					[in] BOOL bRemote, 		// TRUE: Notification interface is out-of-proc/remote.  FALSE:  Notification interface in inproc.
					[out] DWORD* pdwCookie ); 	// Token used to "turn off" notifications.

	HRESULT Unadvise( [in] DWORD dwCookie );
};


