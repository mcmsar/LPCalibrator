cpp_quote("#ifndef INC_LOCATE")
cpp_quote("#define INC_LOCATE")


import "unknwn.idl";
import "emstypex.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	uuid(CD360651-E910-11d5-8D1E-009027912866),
	helpstring("IEMSLOCATEdata"),
	pointer_default(unique)
]

interface IEMSLOCATEdata
{
	#pragma pack(1)

	#define EMSBEACONMSGLEN ( 18 ) // ie 144 bits
	#define EMSMAXSATIDS	( 128 )
	#define EMSMAXLUTIDS	( 128 )
	#define EMS_LOCATE_COVARMATRIX_LENGTH (10) 

cpp_quote("#define EMSBEACONMSGLEN ( 18 ) // ie 144 bits")
cpp_quote("#define EMSMAXSATIDS	( 128 )")
cpp_quote("#define EMSMAXLUTIDS	( 128 )")
cpp_quote("#define EMS_LOCATE_COVARMATRIX_LENGTH (10) ")

cpp_quote("#define EMS_LOCATE_MAX_ITERATIONS_FLAG (0x8000) ")

cpp_quote("#define EMS_LOCATE_WINDOWFACTOR_MASK 		( 0x0FFF )")
cpp_quote("#define EMS_LOCATE_WINDOWFACTOR_LOCAL_FLAG ( 0x8000 )")

	typedef enum _tagEMSLOCATETYPE
	{
		EMSLOCTYPE_CBC					= 0x0010,
		EMSLOCTYPE_406_MERGE			= 0x0008, // extra bit in data set type used for merge record
		EMSLOCTYPE_406					= 0x0020,
		EMSLOCTYPE_FDOA			 	= 0x0040,	// Freq Diff of Arrival
		EMSLOCTYPE_406_GEO			= 0x0080,

		EMSLOCTYPE_TDOA			 	= 0x0100,	// Time Diff of Arrival

		EMSLOCTYPE_BASETYPE_MASK 	= 0x01FF,

		EMSLOCTYPE_UNCONFIRMED		= 0x200,
		EMSLOCTYPE_DETECT_ONLY	 	= 0x400,

		EMSLOCTYPE_REAL_BASE_MASK 	= 0x07FF,
		EMSLOCTYPE_A_SIDE	= 0x0,
		EMSLOCTYPE_B_SIDE				= 0x800,
		EMSLOCTYPE_TEST				= 0x1000,
		EMSLOCTYPE_ENCODED			= 0x2000,
		EMSLOCTYPE_ENCODED_ENCRYPTED= 0x4000,
		EMSLOCTYPE_ABGEN            = 0x8000,

		EMSLOCTYPE_406_FDOA			= EMSLOCTYPE_406 | EMSLOCTYPE_FDOA,
		EMSLOCTYPE_406_FDOA_DETECT	= EMSLOCTYPE_406_FDOA | EMSLOCTYPE_DETECT_ONLY,

		EMSLOCTYPE_406_TDOA				= EMSLOCTYPE_406 | EMSLOCTYPE_TDOA,
		EMSLOCTYPE_406_FDOA_TDOA		= EMSLOCTYPE_406_TDOA | EMSLOCTYPE_406_FDOA,

		EMSLOCTYPE_CBC_DETECT			= 0x410,
		EMSLOCTYPE_406_DETECT			= 0x420,
		EMSLOCTYPE_CBC_B					= 0x810,
		EMSLOCTYPE_406_B					= 0x820,

		EMSLOCTYPE_CBC_121				= EMSLOCTYPE_CBC + 1,
		EMSLOCTYPE_CBC_243				= EMSLOCTYPE_CBC + 2,
		EMSLOCTYPE_CBC_121_243			= EMSLOCTYPE_CBC + 3,
		EMSLOCTYPE_CBC_406				= EMSLOCTYPE_CBC + 4,

		EMSLOCTYPE_406_SARP				= EMSLOCTYPE_406 + 1,
		EMSLOCTYPE_406_SARR				= EMSLOCTYPE_406 + 2,
		EMSLOCTYPE_406_SARP_SARR		= EMSLOCTYPE_406 + 3,

		EMSLOCTYPE_406_FDOA_SARP 			= EMSLOCTYPE_406_FDOA | EMSLOCTYPE_406_SARP,
		EMSLOCTYPE_406_FDOA_SARR 			= EMSLOCTYPE_406_FDOA | EMSLOCTYPE_406_SARR,
		EMSLOCTYPE_406_FDOA_SARP_SARR		= EMSLOCTYPE_406_FDOA | EMSLOCTYPE_406_SARP_SARR,

		EMSLOCTYPE_CBC_121_B			= EMSLOCTYPE_CBC_B + 1,
		EMSLOCTYPE_CBC_243_B			= EMSLOCTYPE_CBC_B + 2,
		EMSLOCTYPE_CBC_121_243_B		= EMSLOCTYPE_CBC_B + 3,
		EMSLOCTYPE_CBC_406_B			= EMSLOCTYPE_CBC_B + 4,

		EMSLOCTYPE_406_SARP_B			= EMSLOCTYPE_406_B + 1,
		EMSLOCTYPE_406_SARR_B			= EMSLOCTYPE_406_B + 2,
		EMSLOCTYPE_406_SARP_SARR_B		= EMSLOCTYPE_406_B + 3,

		EMSLOCTYPE_CBC_121_DETECT		= EMSLOCTYPE_CBC_DETECT + 1,
		EMSLOCTYPE_CBC_243_DETECT		= EMSLOCTYPE_CBC_DETECT + 2,
		EMSLOCTYPE_CBC_121_243_DETECT	= EMSLOCTYPE_CBC_DETECT + 3,
		EMSLOCTYPE_CBC_406_DETECT		= EMSLOCTYPE_CBC_DETECT + 4,

		EMSLOCTYPE_406_SARP_DETECT		= EMSLOCTYPE_406_DETECT + 1,
		EMSLOCTYPE_406_SARR_DETECT		= EMSLOCTYPE_406_DETECT + 2,
		EMSLOCTYPE_406_SARP_SARR_DETECT	= EMSLOCTYPE_406_DETECT + 3,

		EMSLOCTYPE_406_FDOA_SARP_B 	  	= EMSLOCTYPE_406_FDOA_SARP | EMSLOCTYPE_B_SIDE,
		EMSLOCTYPE_406_FDOA_SARR_B 	  	= EMSLOCTYPE_406_FDOA_SARR | EMSLOCTYPE_B_SIDE,
		EMSLOCTYPE_406_FDOA_SARP_SARR_B= EMSLOCTYPE_406_FDOA_SARP_SARR | EMSLOCTYPE_B_SIDE,

		EMSLOCTYPE_406_FDOA_SARP_DETECT 	  	= EMSLOCTYPE_406_FDOA_SARP | EMSLOCTYPE_DETECT_ONLY,
		EMSLOCTYPE_406_FDOA_SARR_DETECT 	  	= EMSLOCTYPE_406_FDOA_SARR | EMSLOCTYPE_DETECT_ONLY,
		EMSLOCTYPE_406_FDOA_SARP_SARR_DETECT= EMSLOCTYPE_406_FDOA_SARP_SARR | EMSLOCTYPE_DETECT_ONLY,

		EMSLOCTYPE_GEO_SARR			 = EMSLOCTYPE_406_GEO + EMSLOCTYPE_406_SARR_DETECT,
		EMSLOCTYPE_GEO_SARR_UNCONFIRMED = EMSLOCTYPE_GEO_SARR + EMSLOCTYPE_UNCONFIRMED

    }	EMSLOCATETYPE;

	typedef struct _tagEMSWLSLOCATE
	{
		EMSLOCATION location;			// lat/long/altitude
		double		dFrequency;			// Transmit Frequency in MHz 
		float		fFreqDrift;			// Frequency drift in Hz/min

		WORD		wNumMsgs;			// Number of measurements 
		WORD		wNumMsgsUsed;		// Number of measurements used in location estimate
		WORD		wNumBurstsUsed;	// Number of transmissions
		WORD		wNumIterations;		// Number of iterations ( if negative no convergence)
		float		fRadiusErrEllipse;	// Equivalent radius of error ellipse (km)
		float		fFreqBiasError;		// Frequency bias error (Hz)
		float		fMajorError;		// Semi-major axis of error ellipse (km)
		float		fMinorError;		// Semi-minor axis of error ellipse (km)
		float		fHeading;			// Heading direction of error ellipse (deg Azimuth)
		float		fRMS;				// RMS of frequency measurement residuals (Hz) 
		float		fTrend;				// Trend factor of residuals (Hz) (sign extended 2nd  correlation coef)
		float		fCoVarianceMatrix[ EMS_LOCATE_COVARMATRIX_LENGTH];	//
	}	EMSWLSLOCATE, *LPEMSWLSLOCATE;

	typedef struct _tagEMSCBCLOCATE
	{
		// fields only important for CBC
		float		fSweep;			// sweep period (sec) (set zero if continuous, set negative if not detected)
		float		fSweepError;	// RMS of sweep period (sec)
		WORD		wSidebands;		// Number of (merged or detected) sidebands
	}	EMSCBCLOCATE, *LPEMSCBCLOCATE;

	typedef struct _tagEMS406LOCATE
	{
		// fields only important for 406 
		BYTE		cBeaconMsg[ EMSBEACONMSGLEN ];
		WORD		wBitErrorFrameSync;	// Number of bit errors in frame synch
		WORD		wBitErrorField1;	// Number of bit errors in first protected field
		WORD		wBitErrorField2;	// Number of bit errors in second protected field
	} EMS406LOCATE, *LPEMS406LOCATE;

	typedef struct _tagEMSLOCATE
	{
		EMSTIME		time;
		ULONG		ulLutID;			// Lut responsible for creating locate record
		WORD		wType;			// data byte : SGB, FGB, etc. ??
		BYTE		cSatIDs[ EMSMAXSATIDS / 8 ];	// bit encoded SatIDs
		BYTE		cLutIDs[ EMSMAXLUTIDS / 8 ];	// bit encoded LutIDs
		ULONG		ulSatPassID;	// if only one satellite
		INT64		i64BeaconID;
		EMSWLSLOCATE wlsSolution;
	
		EMSTIME		timeTCA;			// time of closest approach
		float		fCrossTrackAngle;	// Cross-track angle : CTA (deg)
		WORD		wWindowFactor;		// (as defined by COSPAS-SARSAT)
		float		fConfidence;		// ( as defined by COSPAS-SARSAT )
		float		fProbability;		// Ambiguity probability of location (A side > .5)
		float		fPower;				// Transmit Power estimate ( dBm )

		EMSTIME timeFirstData;
		EMSTIME timeLastData;

    [switch_type(EMSLOCATETYPE), switch_is((EMSLOCATETYPE)(wType & EMSLOCTYPE_REAL_BASE_MASK ) )]
		union
		{
			[ case(	EMSLOCTYPE_CBC ) ]
					EMSCBCLOCATE recCBC;
			[ default ]
					EMS406LOCATE rec406;
		} info;
	} EMSLOCATE, *LPEMSLOCATE;


#pragma pack()
}

cpp_quote("#endif //INC_LOCATE")
