[
	object, 
	uuid(2E941035-468A-4d65-AF78-3D6F81B9A37B),
	helpstring("IEMSMCCGtwy Interface"),
	pointer_default(unique)
]
interface IEMSMCCGtwy : IUnknown
{
	HRESULT SendLocation(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulSits,
							[in,size_is(ulSits)] long* alSitIDs,
							[in] unsigned long ulSatID,
							[in] unsigned long ulPassID,
							[in] unsigned long ulLocations,
							[in,size_is(ulLocations)] EMSSITLOCALERTSOLUTION** apLocations );

	HRESULT SendAlarm(	[in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] EMSTRIGGER eTrigger,
						[in,string] wchar_t* wszSource,
						[in,string] wchar_t* wszMsg,
						[in] unsigned long ulSatID,
						[in] unsigned long ulPassID );

	HRESULT SendWarning(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in,string] wchar_t* wszSource,
							[in,string] wchar_t* wszMsg,
							[in] unsigned long ulSatID,
							[in] unsigned long ulPassID );

	HRESULT SendStatus(	[in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] EMSTRIGGER eTrigger,
						[in] unsigned long ulNumStatus,
						[in,size_is(ulNumStatus)] EMS605ADATA** apStatus,
						[in] unsigned long ulSatID,
						[in] unsigned long ulPassID );

	HRESULT SendOrbitVector(	[in] unsigned long ulDestID,
								[in] EMSGATEWAYTOKEN* psecToken,
								[in] EMSTRIGGER eTrigger,
								[in] unsigned long ulCmdMsgSequence,
								[in] unsigned long ulSitID,
								[in] EMSSITCONTROLCODE eCtrlCode,
								[in] unsigned long ulOrbits,
								[in,size_is(ulOrbits)]	EMSSIT215DATA** apOrbVectors );

	HRESULT SendTLE(	[in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] EMSTRIGGER eTrigger,
						[in] unsigned long ulCmdMsgSequence,
						[in] EMSSITCONTROLCODE eCtrlCode,
						[in] unsigned long ulOrbits,
						[in,size_is(ulOrbits)] EMSSIT255ADATA** apTLEs );

	HRESULT SendPassSchedule(	[in] unsigned long ulDestID,
								[in] EMSGATEWAYTOKEN* psecToken,
								[in] EMSTRIGGER eTrigger,
								[in] unsigned long ulCmdMsgSequence,
								[in] EMSSCHEDUSAGE eUsage, 
								[in] long lSatelliteCount, 
								[in] unsigned long ulPasses, 
								[in,size_is(ulPasses)] EMSSATELLITETRACK** apPasses );

	HRESULT SendMetopSchedule(	[in] unsigned long ulDestID,
								[in] EMSGATEWAYTOKEN* psecToken,
								[in] EMSTRIGGER eTrigger,
								[in] unsigned long ulEntries, 
								[in,size_is(ulEntries)] EMSMANOEUVREDATA** apManoeuvres );

	HRESULT SendSARPCalib(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulCmdMsgSequence,
							[in] unsigned long ulSit,
							[in] EMSSITCONTROLCODE eCtrlCode,
							[in] unsigned long ulMsgRequestNumber,
							[in] unsigned long ulSatID,
							[in] unsigned long ulPassID,
							[in] EMSTIME timeRollover,
							[in] double dUSOFrequency );

	HRESULT SendSARRCalib(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulCmdMsgSequence,
							[in] unsigned long ulSit,
							[in] EMSSITCONTROLCODE eCtrlCode,
							[in] unsigned long ulSatellites,
							[in,size_is(ulSatellites)] EMSSARRCALIBDATA** apSarrData );

	HRESULT SendStartUp(	[in] unsigned long ulDestID, 
							[in] EMSGATEWAYTOKEN* psecToken, 
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulCmdMsgSequence );

	HRESULT SendLEOPassSummary(	[in] unsigned long ulDestID,
								[in] EMSGATEWAYTOKEN* psecToken,
								[in] EMSTRIGGER eTrigger,
								[in] unsigned long ulSatID,
								[in] unsigned long ulPassID,
								[in] EMSPASSSUMMARYINFO2* pSummary );

	HRESULT SendGEOPassSummary(	[in] unsigned long ulDestID,
								[in] EMSGATEWAYTOKEN* psecToken,
								[in] EMSTRIGGER eTrigger,
								[in] unsigned long ulSatID,
								[in] unsigned long ulPassID,
								[in] EMSGEOSUMMARYINFO* pSummary );

	HRESULT SendCmdAck(	[in] unsigned long ulDestID,
						[in] EMSGATEWAYTOKEN* psecToken,
						[in] EMSTRIGGER eTrigger,
						[in] unsigned long ulCommandMsgSequence,
						[in,string] wchar_t* wszStatus );

	HRESULT SendCommsCheck(	[in] unsigned long ulDestID, 
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger );

	HRESULT SendCommand(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulCmdMsgSequence,
							[in] EMSOPERATORCMD* popCommand );

	HRESULT RequestRetransmitMsgs(	[in] unsigned long ulDestID,
									[in] EMSGATEWAYTOKEN* psecToken,
									[in] EMSTRIGGER eTrigger,
									[in] unsigned long ulCmdMsgSequence,
									[in] unsigned long ulSendToID,
									[in] unsigned long ulSeqStart,
									[in] unsigned long ulSeqEnd );

	HRESULT SendMessages(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulCount,
							[in,string,size_is(ulCount)] wchar_t** awszFilePath );

	HRESULT SendDataReport(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulMessages,
							[in,string,size_is(ulMessages)] wchar_t** awszMessages );

	HRESULT SendAlarmsAsLog(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulAlarms,
							[in,size_is(ulAlarms)] EMSLOGDATA* aLogData );

	HRESULT SendWarningsAsLog(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulWarnings,
							[in,size_is(ulWarnings)] EMSLOGDATA* aLogData );

	HRESULT SendStatusAsLog(	[in] unsigned long ulDestID,
							[in] EMSGATEWAYTOKEN* psecToken,
							[in] EMSTRIGGER eTrigger,
							[in] unsigned long ulStatus,
							[in,size_is(ulStatus)] EMSLOGDATA* aLogData );

};

//! @struct tagEMSCalib406DataIdentity
