		EMSTIME					timeEffective;
		EMSTIME					timeEpoch;
	} EMSSATORBITINFO, *LPEMSSATORBITINFO;

#pragma pack()

	HRESULT SetSatBehaviourMaxCount( [in] ULONG ulSatelliteID, [in] WORD wCount );
	HRESULT SetSatBehaviourCount( [in] ULONG ulSatelliteID, [in] WORD wCount );
	HRESULT SetSatBehaviour( [in] ULONG ulSatelliteID, [in] WORD wIndex, [in] EMSSATBEHAVIOUR *lpBehaviour );

