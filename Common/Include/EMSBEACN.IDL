import "unknwn.idl";
import "emstypex.idl";
import "emsicfg.idl";

#define _EMS_RPC_VERSION 1
#define __RPC_FAR 

[
	object, uuid(E22CF572-964F-11d5-8C04-009027912866),
	helpstring("IEMSRefBeaconInfo Interface"),
	pointer_default(unique)
]

interface IEMSRefBeaconInfo : IEMSConfigSettings
{
	typedef struct _tagEMSREFBEACONDATA
	{
		EMSTIME	     	timeUpdate;         // Time of last update in seconds from 1970
		unsigned short  uFlag;              // Action flag (transmit to MCC, use for Kalman filter processing, etc.)
     unsigned short  uGroup;             // Number of group
		unsigned char   cBeaconId[8];       // Beacon ID  
		unsigned char   cBeaconMsg[18];     // Full 144 bit pattern
		double           dLatitude;          // Geodetic Latitude (degN)
		double           dLongitude;         // Geodetic Longitude (degE)
		double           dAltitude;          // Altitude (m from mean sea level)
//		double           dFreqOffset;        // Carrier Frequency Offset in Hz from 406.0 MHz
		double           dFrequency;        // Carrier Frequency in Hz
		double           dPower;             // Nominal Transmit Power (dBm)
		double           dRepRate;           // Nominal Message Repetition Rate in sec
		double           dBitRate;           // Nominal Bit Rate in bits/sec
		double           dModIndex;          // Nominal Modulation Index in radians
	} EMSREFBEACONDATA, *LPEMSREFBEACONDATA;

	typedef struct _tagEMSREFBEACONDATAEX
	{
		INT64 i64BeaconID;
		EMSREFBEACONDATA data;
	} EMSREFBEACONDATAEX, *LPEMSREFBEACONDATAEX;

	HRESULT GetData( [in] __int64 i64BeaconID, [out] EMSREFBEACONDATA *lpData );
	HRESULT GetIndexedData( [in] int nIndex, [out] __int64 *lpi64BeaconID, [out] EMSREFBEACONDATA *lpData );
	HRESULT GetCount( [out] ULONG *lpulCount );
};

typedef [unique] IEMSRefBeaconInfo *LPEMSREFBEACONINFO;

[
	object, uuid(0072892C-5517-44a5-A002-E3D9900432A8),
	helpstring("IEMSRefBeaconInfo2 Interface"),
	pointer_default(unique)
]

interface IEMSRefBeaconInfo2 : IEMSRefBeaconInfo
{
#pragma pack(1)

	typedef struct _tagEMSREFBEACONACCURACY
	{
		double	dMinCTA;
		double	dMaxCTA;
		double	dMaxTCARange;
		INT		nMinPts;
		double	dWarnDistance;
		double	dAlarmDistance;
		double	dReserved1;
		double	dReserved2;
		INT		nReserved3;
		INT		nReserved4;
	} EMSREFBEACONACCURACY, *LPEMSREFBEACONACCURACY;

#pragma pack()

	HRESULT GetAccuracyInfo( [in] INT64 i64BeaconID, [out] LPEMSREFBEACONACCURACY lpInfo );
	HRESULT GetAccuracyInfoByIndex( [in] INT nIndex, [out] INT64 *lpi64BeaconID, [out] LPEMSREFBEACONACCURACY lpInfo );
};

typedef [unique] IEMSRefBeaconInfo2 *LPEMSREFBEACONINFO2;


[
	object, uuid(4FBBD782-85C0-4d69-931E-6662537B69BC),
	helpstring("IEMSRefBeaconInfo3 Interface"),
	pointer_default(unique)
]

interface IEMSRefBeaconInfo3 : IEMSRefBeaconInfo2
{
	HRESULT GetIsQMS( [in] const INT64 ci64BeaconID, [out] BOOL* pbIsQMS );
};

typedef [unique] IEMSRefBeaconInfo3 *LPEMSREFBEACONINFO3;

